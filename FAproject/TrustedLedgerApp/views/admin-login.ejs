<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Login | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #0f172a;
        --muted: #cbd5f5;
        --panel: #ffffff;
        --border: #ef4444;
        --accent: #f97316;
        --dark: #0b0f1a;
        --shadow: 0 20px 45px rgba(2, 6, 23, 0.45);
        --radius-lg: 18px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        color: var(--panel);
        background: radial-gradient(circle at top, #1a2438 0%, #0b0f1a 60%);
        min-height: 100vh;
      }

      .page {
        min-height: calc(100vh - 70px);
        display: grid;
        place-items: center;
        padding: 40px 20px 60px;
      }

      .shell {
        width: min(460px, 100%);
        text-align: center;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        background: #ffffff;
        color: #0b0f1a;
        padding: 10px 18px;
        border-radius: 12px;
        font-weight: 600;
      }

      .brand svg {
        width: 20px;
        height: 20px;
      }

      .card {
        margin-top: 16px;
        background: var(--panel);
        color: var(--ink);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow);
      }

      .card-header {
        padding: 16px 18px;
        background: linear-gradient(90deg, #f97316, #ef4444);
        color: #fff;
        text-align: left;
      }

      .card-header h2 {
        margin: 0 0 4px;
        font-size: 16px;
      }

      .card-header p {
        margin: 0;
        font-size: 12px;
        opacity: 0.9;
      }

      .card-body {
        padding: 18px;
        text-align: left;
        display: grid;
        gap: 14px;
      }

      label {
        font-size: 12px;
        font-weight: 600;
        color: #1f2937;
      }

      input {
        width: 100%;
        border: 1px solid #e5e7eb;
        background: #f3f4f6;
        border-radius: 10px;
        padding: 12px 14px;
        font-size: 13px;
        outline: none;
      }

      .btn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 10px 12px;
        font-weight: 600;
        font-size: 13px;
        color: #fff;
        background: #ea580c;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
      }

      .btn svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      .demo {
        border: 1px solid #fed7aa;
        background: #fff7ed;
        color: #9a3412;
        border-radius: 12px;
        padding: 12px;
        font-size: 12px;
      }

      .demo strong {
        display: block;
        margin-bottom: 4px;
      }

      .back-link {
        margin-top: 12px;
        display: inline-flex;
        justify-content: center;
        width: 100%;
        font-size: 12px;
        color: #93c5fd;
        text-decoration: none;
      }

      .warning {
        margin-top: 16px;
        border: 1px solid #f59e0b;
        background: rgba(251, 191, 36, 0.1);
        color: #fbbf24;
        padding: 12px;
        border-radius: 12px;
        font-size: 12px;
        text-align: left;
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <div class="shell">
        <div class="brand">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M12 2l8 4.5v11L12 22l-8-4.5v-11L12 2z" />
            <path d="M12 2v8.5m0 0L4 6.5m8 4L20 6.5M12 10.5l8 4.5M12 10.5L4 15" />
          </svg>
          BlockChain Track
        </div>

        <form class="card" action="/login" method="post">
          <div class="card-header">
            <h2>Admin Login</h2>
            <p>Restricted access - Admin credentials required</p>
          </div>

          <div class="card-body">
            <input type="hidden" name="role" value="admin" />

            <div class="form-group">
              <label for="admin-email">Admin Email</label>
              <input id="admin-email" name="email" type="email" placeholder="admin@blockchaintrack.com" required />
            </div>

            <div class="form-group">
              <label for="admin-password">Password</label>
              <input id="admin-password" name="password" type="password" placeholder="••••••••" required />
            </div>

            <button class="btn" type="submit">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M7 11h10" />
                <path d="M12 6l5 5-5 5" />
              </svg>
              Login as Admin
            </button>

            <div class="demo">
              <strong>Demo Admin Account:</strong>
              Admin: main@gmail.com / 123456
            </div>
          </div>
        </form>

        <a class="back-link" href="/login">&larr; Back to User Login</a>

        <div class="warning">
          Admin Area: Unauthorized access is prohibited
        </div>
      </div>
    </main>
  </body>
</html>
