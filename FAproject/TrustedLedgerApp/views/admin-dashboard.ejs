<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #111827;
        --muted: #6b7280;
        --panel: #ffffff;
        --soft: #f3f4f6;
        --border: #e5e7eb;
        --brand: #2f5bf0;
        --green: #16a34a;
        --purple: #8b5cf6;
        --orange: #f97316;
        --shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        --radius-lg: 16px;
        --radius-md: 12px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        color: var(--ink);
        background: #f5f7fb;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
      }

      .stat-card {
        background: var(--panel);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        box-shadow: var(--shadow);
      }

      .stat-card h4 {
        margin: 0 0 6px;
        font-size: 12px;
        color: var(--muted);
        font-weight: 600;
      }

      .stat-card .value {
        font-size: 22px;
        font-weight: 700;
      }

      .stat-card small {
        font-size: 11px;
        color: var(--muted);
      }

      .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        color: #fff;
      }

      .icon-blue {
        background: #dbe6ff;
        color: var(--brand);
      }

      .icon-green {
        background: #dcfce7;
        color: var(--green);
      }

      .icon-purple {
        background: #ede9fe;
        color: var(--purple);
      }

      .icon-orange {
        background: #ffedd5;
        color: var(--orange);
      }

      .tabs {
        margin-top: 18px;
        background: #ededf1;
        border-radius: 999px;
        padding: 4px;
        display: inline-flex;
        gap: 4px;
      }

      .tab {
        border: none;
        background: transparent;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        color: var(--ink);
      }

      .tab.active {
        background: #fff;
        box-shadow: 0 8px 16px rgba(15, 23, 42, 0.08);
      }

      .panel {
        margin-top: 14px;
        background: var(--panel);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 16px;
        box-shadow: var(--shadow);
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }

      .panel-header h3 {
        margin: 0;
        font-size: 14px;
      }

      .btn {
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        background: #0b1020;
        color: #fff;
        cursor: pointer;
      }

      .search {
        width: 100%;
        border: 1px solid var(--border);
        background: var(--soft);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 12px;
        margin-bottom: 12px;
      }

      .list {
        display: grid;
        gap: 10px;
      }

      .row {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center;
      }

      .thumb {
        width: 46px;
        height: 46px;
        border-radius: 8px;
        background: #f3f4f6;
        object-fit: cover;
      }

      .row h4 {
        margin: 0 0 4px;
        font-size: 13px;
      }

      .row p {
        margin: 0;
        font-size: 11px;
        color: var(--muted);
      }

      .pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 600;
        background: #f3f4ff;
        color: var(--brand);
      }

      .action-buttons {
        display: inline-flex;
        gap: 6px;
      }

      .icon-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-size: 12px;
      }

      .panel-section {
        display: none;
      }

      .panel-section.active {
        display: block;
      }

      .user-actions {
        display: inline-flex;
        gap: 8px;
      }

      .btn-outline {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--ink);
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
      }

      .info-box {
        margin-top: 12px;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        border-radius: 10px;
        padding: 10px;
        font-size: 11px;
        color: #1e3a8a;
        line-height: 1.6;
      }

      @media (max-width: 980px) {
        .stat-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 720px) {
        .stat-grid {
          grid-template-columns: 1fr;
        }

        .row {
          grid-template-columns: 1fr;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <section class="stat-grid">
        <div class="stat-card">
          <div>
            <h4>Total Products</h4>
            <div class="value">5</div>
          </div>
          <div class="stat-icon icon-blue">▣</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Orders</h4>
            <div class="value">3</div>
            <small>1 pending</small>
          </div>
          <div class="stat-icon icon-green">▤</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Users</h4>
            <div class="value">2</div>
            <small>2 admins</small>
          </div>
          <div class="stat-icon icon-purple">◉</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Revenue</h4>
            <div class="value">$548.89</div>
            <small>1 completed</small>
          </div>
          <div class="stat-icon icon-orange">▥</div>
        </div>
      </section>

      <div class="tabs" role="tablist">
        <button class="tab active" type="button" data-tab="products">Products</button>
        <button class="tab" type="button" data-tab="orders">Orders</button>
        <button class="tab" type="button" data-tab="users">Users</button>
      </div>

      <section class="panel panel-section active" data-panel="products">
        <div class="panel-header">
          <h3>Product Management</h3>
          <button class="btn" type="button">Add Product</button>
        </div>
        <input class="search" placeholder="Search products..." />
        <div class="list">
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e" alt="Product" />
            <div>
              <h4>Premium Wireless Headphones <span class="pill">Electronics</span></h4>
              <p>Premium ANC headphones with 30h battery life and superior sound quality.</p>
              <p>$299.99 &nbsp;&nbsp; Stock 45 &nbsp;&nbsp; ID: 1</p>
            </div>
            <div class="action-buttons">
              <button class="icon-btn" type="button">✎</button>
              <button class="icon-btn" type="button">🗑</button>
            </div>
          </div>
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1540555700478-4be289fbecef" alt="Product" />
            <div>
              <h4>Organic Skincare Gift Set <span class="pill">Beauty &amp; Health</span></h4>
              <p>100% organic skincare collection with natural ingredients.</p>
              <p>$89.9 &nbsp;&nbsp; Stock 78 &nbsp;&nbsp; ID: 2</p>
            </div>
            <div class="action-buttons">
              <button class="icon-btn" type="button">✎</button>
              <button class="icon-btn" type="button">🗑</button>
            </div>
          </div>
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1519389950473-47ba0277781c" alt="Product" />
            <div>
              <h4>Smart Fitness Tracker Watch <span class="pill">Fitness &amp; Sports</span></h4>
              <p>Advanced fitness tracker with heart rate monitoring and GPS.</p>
              <p>$159 &nbsp;&nbsp; Stock 120 &nbsp;&nbsp; ID: 3</p>
            </div>
            <div class="action-buttons">
              <button class="icon-btn" type="button">✎</button>
              <button class="icon-btn" type="button">🗑</button>
            </div>
          </div>
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1509042239860-f550ce710b93" alt="Product" />
            <div>
              <h4>Artisan Coffee Bean Collection <span class="pill">Food &amp; Beverage</span></h4>
              <p>Premium single-origin coffee beans from around the world.</p>
              <p>$45.5 &nbsp;&nbsp; Stock 95 &nbsp;&nbsp; ID: 4</p>
            </div>
            <div class="action-buttons">
              <button class="icon-btn" type="button">✎</button>
              <button class="icon-btn" type="button">🗑</button>
            </div>
          </div>
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1521572163474-6864f9cf17ab" alt="Product" />
            <div>
              <h4>Minimalist Leather Backpack <span class="pill">Fashion &amp; Accessories</span></h4>
              <p>Handcrafted full-grain leather backpack with laptop compartment.</p>
              <p>$189 &nbsp;&nbsp; Stock 32 &nbsp;&nbsp; ID: 5</p>
            </div>
            <div class="action-buttons">
              <button class="icon-btn" type="button">✎</button>
              <button class="icon-btn" type="button">🗑</button>
            </div>
          </div>
        </div>
      </section>

      <section class="panel panel-section" data-panel="orders">
        <div class="panel-header">
          <h3>Order Management</h3>
        </div>
        <div class="list">
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e" alt="Order" />
            <div>
              <h4>Premium Wireless Headphones</h4>
              <p>ORD-2025-001</p>
              <p>28/11/2025, 6:30:00 pm</p>
            </div>
            <div>
              <p>Amount</p>
              <p><strong>$299.99 ETHR</strong> <span class="pill" style="background:#ecfdf3;color:#16a34a;">delivered</span></p>
              <button class="btn-outline" type="button">View Details</button>
            </div>
          </div>
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1540555700478-4be289fbecef" alt="Order" />
            <div>
              <h4>Organic Skincare Gift Set</h4>
              <p>ORD-2025-002</p>
              <p>01/12/2025, 5:15:00 pm</p>
            </div>
            <div>
              <p>Amount</p>
              <p><strong>$89.9 ETHR</strong> <span class="pill" style="background:#ede9fe;color:#7c3aed;">shipped</span></p>
              <button class="btn-outline" type="button">View Details</button>
            </div>
          </div>
          <div class="row">
            <img class="thumb" src="https://images.unsplash.com/photo-1519389950473-47ba0277781c" alt="Order" />
            <div>
              <h4>Smart Fitness Tracker Watch</h4>
              <p>ORD-2025-003</p>
              <p>02/12/2025, 7:20:00 pm</p>
            </div>
            <div>
              <p>Amount</p>
              <p><strong>$159 ETHR</strong> <span class="pill" style="background:#fef9c3;color:#ca8a04;">pending</span></p>
              <button class="btn-outline" type="button">View Details</button>
            </div>
          </div>
        </div>
      </section>

      <section class="panel panel-section" data-panel="users">
        <div class="panel-header">
          <h3>User Management</h3>
          <span class="pill" style="background:#fff7ed;color:#c2410c;">Limited Access - Super Admin Required for Promotion</span>
        </div>
        <input class="search" placeholder="Search users by name, email, or role..." />
        <div class="list">
          <div class="row">
            <div>
              <h4>John Doe <span class="pill">User</span></h4>
              <p>user@example.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 15/01/2024</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button">Promote to Admin</button>
              <button class="btn-outline" type="button" style="color:#dc2626;border-color:#fecaca;">Deactivate</button>
            </div>
          </div>
          <div class="row">
            <div>
              <h4>Admin User <span class="pill" style="background:#fff7ed;color:#c2410c;">Admin</span></h4>
              <p>admin@blockchaintrack.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 20/11/2023</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button">Demote to User</button>
              <button class="btn-outline" type="button" style="color:#dc2626;border-color:#fecaca;">Deactivate</button>
            </div>
          </div>
          <div class="row">
            <div>
              <h4>Super Administrator <span class="pill" style="background:#fef9c3;color:#ca8a04;">Super Admin</span></h4>
              <p>superadmin@blockchaintrack.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 01/01/2023</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button" style="color:#a16207;border-color:#fde68a;">Cannot Modify</button>
            </div>
          </div>
          <div class="row">
            <div>
              <h4>Sarah Chen <span class="pill">User</span></h4>
              <p>sarah@example.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 10/03/2024</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button">Promote to Admin</button>
              <button class="btn-outline" type="button" style="color:#dc2626;border-color:#fecaca;">Deactivate</button>
            </div>
          </div>
        </div>
        <div class="info-box">
          <strong>User Management Rules:</strong><br />
          - Super Admin can promote users to admin and demote admins<br />
          - Regular Admin can view users but cannot change roles<br />
          - Super Admin account cannot be demoted or deactivated<br />
          - Deactivated users cannot login to the system
        </div>
      </section>
    </main>

    <script>
      const tabs = Array.from(document.querySelectorAll(".tab"));
      const panels = Array.from(document.querySelectorAll(".panel-section"));

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.classList.remove("active"));
          panels.forEach((panel) => panel.classList.remove("active"));
          tab.classList.add("active");
          const target = tab.dataset.tab;
          const panel = document.querySelector(`[data-panel="${target}"]`);
          if (panel) {
            panel.classList.add("active");
          }
        });
      });
    </script>
  </body>
</html>
