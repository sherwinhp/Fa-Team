<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #111827;
        --muted: #6b7280;
        --panel: #ffffff;
        --soft: #f3f4f6;
        --border: #e5e7eb;
        --brand: #2f5bf0;
        --green: #16a34a;
        --purple: #8b5cf6;
        --orange: #f97316;
        --shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        --radius-lg: 16px;
        --radius-md: 12px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        color: var(--ink);
        background: #f5f7fb;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
      }

      .stat-card {
        background: var(--panel);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        box-shadow: var(--shadow);
      }

      .stat-card h4 {
        margin: 0 0 6px;
        font-size: 12px;
        color: var(--muted);
        font-weight: 600;
      }

      .stat-card .value {
        font-size: 22px;
        font-weight: 700;
      }

      .stat-card small {
        font-size: 11px;
        color: var(--muted);
      }

      .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        color: #fff;
      }

      .icon-blue {
        background: #dbe6ff;
        color: var(--brand);
      }

      .icon-green {
        background: #dcfce7;
        color: var(--green);
      }

      .icon-purple {
        background: #ede9fe;
        color: var(--purple);
      }

      .icon-orange {
        background: #ffedd5;
        color: var(--orange);
      }

      .tabs {
        margin-top: 18px;
        background: #ededf1;
        border-radius: 999px;
        padding: 4px;
        display: inline-flex;
        gap: 4px;
      }

      .tab {
        border: none;
        background: transparent;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        color: var(--ink);
      }

      .tab.active {
        background: #fff;
        box-shadow: 0 8px 16px rgba(15, 23, 42, 0.08);
      }

      .panel {
        margin-top: 14px;
        background: var(--panel);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 16px;
        box-shadow: var(--shadow);
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }

      .panel-header h3 {
        margin: 0;
        font-size: 14px;
      }

      .btn {
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        background: #0b1020;
        color: #fff;
        cursor: pointer;
      }

      .search {
        width: 100%;
        border: 1px solid var(--border);
        background: var(--soft);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 12px;
        margin-bottom: 12px;
      }

      .list {
        display: grid;
        gap: 10px;
      }

      .row {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center;
      }

      .thumb {
        width: 46px;
        height: 46px;
        border-radius: 8px;
        background: #f3f4f6;
        object-fit: cover;
      }

      .row h4 {
        margin: 0 0 4px;
        font-size: 13px;
      }

      .row p {
        margin: 0;
        font-size: 11px;
        color: var(--muted);
      }

      .pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 600;
        background: #f3f4ff;
        color: var(--brand);
      }

      .action-buttons {
        display: inline-flex;
        gap: 6px;
      }

      .icon-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-size: 12px;
      }

      .panel-section {
        display: none;
      }

      .panel-section.active {
        display: block;
      }

      .user-actions {
        display: inline-flex;
        gap: 8px;
      }

      .btn-outline {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--ink);
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
      }

      .order-card {
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 14px;
        background: linear-gradient(135deg, #ffffff 0%, #f8f9ff 100%);
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 16px;
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.06);
      }

      .order-header {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
      }

      .order-title {
        font-size: 14px;
        font-weight: 700;
        margin: 0;
      }

      .order-id {
        font-size: 10px;
        font-weight: 600;
        color: var(--brand);
        background: #eef2ff;
        padding: 4px 8px;
        border-radius: 999px;
      }

      .order-meta {
        display: grid;
        gap: 6px;
        margin-top: 8px;
        font-size: 11px;
        color: var(--muted);
      }

      .order-meta span {
        color: var(--ink);
        font-weight: 600;
        word-break: break-all;
      }

      .order-amount {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        background: #ffffff;
        border: 1px dashed #dbe4ff;
      }

      .order-amount h4 {
        margin: 0;
        font-size: 12px;
        color: var(--muted);
      }

      .order-amount strong {
        font-size: 16px;
      }

      .status-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: 999px;
        letter-spacing: 0.02em;
      }

      .status-actions {
        margin-top: 10px;
        display: grid;
        gap: 8px;
      }

      .status-track {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 6px;
        margin-top: 10px;
      }

      .status-step {
        text-align: center;
        font-size: 9px;
        font-weight: 700;
        padding: 6px 6px;
        border-radius: 999px;
        background: #f3f4f6;
        color: #6b7280;
        border: 1px solid #e5e7eb;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }

      .status-step.done {
        background: #dcfce7;
        color: #15803d;
        border-color: #bbf7d0;
      }

      .status-step.current {
        background: #dbeafe;
        color: #1d4ed8;
        border-color: #bfdbfe;
      }

      .status-select {
        border: 1px solid var(--border);
        background: #fff;
        padding: 8px 10px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 600;
        width: 100%;
      }

      .status-update-btn {
        border: none;
        padding: 8px 12px;
        border-radius: 10px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 45%, #38bdf8 100%);
        color: #fff;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.25);
      }

      .info-box {
        margin-top: 12px;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        border-radius: 10px;
        padding: 10px;
        font-size: 11px;
        color: #1e3a8a;
        line-height: 1.6;
      }

      @media (max-width: 980px) {
        .stat-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 720px) {
        .stat-grid {
          grid-template-columns: 1fr;
        }

        .row {
          grid-template-columns: 1fr;
          align-items: flex-start;
        }

        .order-card {
          grid-template-columns: 1fr;
        }

        .status-track {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <section class="stat-grid">
        <div class="stat-card">
          <div>
            <h4>Total Products</h4>
            <div class="value"><%= products ? products.length : 0 %></div>
          </div>
          <div class="stat-icon icon-blue">▣</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Orders</h4>
            <div class="value">3</div>
            <small>1 pending</small>
          </div>
          <div class="stat-icon icon-green">▤</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Users</h4>
            <div class="value">2</div>
            <small>2 admins</small>
          </div>
          <div class="stat-icon icon-purple">◉</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Revenue</h4>
            <div class="value">$548.89</div>
            <small>1 completed</small>
          </div>
          <div class="stat-icon icon-orange">▥</div>
        </div>
      </section>

      <div class="tabs" role="tablist">
        <button class="tab active" type="button" data-tab="products">Products</button>
        <button class="tab" type="button" data-tab="orders">Orders</button>
        <button class="tab" type="button" data-tab="users">Users</button>
      </div>

      <section class="panel panel-section active" data-panel="products">
        <div class="panel-header">
          <h3>Product Management</h3>
          <a class="btn" href="/addproduct">Add Product</a>
        </div>
        <input class="search" placeholder="Search products..." />
        <div class="list">
          <% if (products && products.length) { %>
            <% products.forEach((product) => { %>
              <div class="row">
                <img class="thumb" src="<%= product.images && product.images.length ? product.images[0] : '/images/default-product.jpeg' %>" alt="Product" />
                <div>
                  <h4><%= product.productInfo.name %> <span class="pill"><%= product.productInfo.category %></span></h4>
                  <p><%= product.productInfo.description %></p>
                  <p>$<%= product.productInfo.price %> ETHR &nbsp;&nbsp; Stock <%= product.stock %> &nbsp;&nbsp; ID: <%= product.id %></p>
                </div>
                <div class="action-buttons">
                  <a class="icon-btn" href="/admin/products/<%= product.id %>/edit" title="Edit product">✎</a>
                  <button class="icon-btn delete-product" type="button" data-product-id="<%= product.id %>">Del</button>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="row">
              <div>
                <h4>No products on-chain yet.</h4>
                <p>Add a product to initialize the on-chain catalog.</p>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <section class="panel panel-section" data-panel="orders">
        <div class="panel-header">
          <h3>Order Management</h3>
        </div>
        <div class="list" id="orderList">
          <div class="row">
            <div>
              <h4>Loading orders...</h4>
              <p>Connect MetaMask with the admin account to view on-chain orders.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="panel panel-section" data-panel="users">
        <div class="panel-header">
          <h3>User Management</h3>
          <span class="pill" style="background:#fff7ed;color:#c2410c;">Limited Access - Super Admin Required for Promotion</span>
        </div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px;">
          <input class="search" id="newUserAddress" placeholder="New user wallet address (0x...)" />
          <button class="btn-outline" id="registerUserButton" type="button">Add User</button>
        </div>
        <div class="list" id="userList">
          <div class="row">
            <div>
              <h4>Loading users...</h4>
              <p>Connect MetaMask with an admin account to manage users.</p>
            </div>
          </div>
        </div>
        <div class="info-box">
          <strong>User Management Rules:</strong><br />
          - Users are stored on-chain via the UserManagement contract<br />
          - Admins can add users and deactivate accounts<br />
          - Super Admin account cannot be deactivated<br />
          - Deactivated users cannot access protected pages
        </div>
      </section>
    </main>

    <script>
      const tabs = Array.from(document.querySelectorAll(".tab"));
      const panels = Array.from(document.querySelectorAll(".panel-section"));

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.classList.remove("active"));
          panels.forEach((panel) => panel.classList.remove("active"));
          tab.classList.add("active");
          const target = tab.dataset.tab;
          const panel = document.querySelector(`[data-panel="${target}"]`);
          if (panel) {
            panel.classList.add("active");
          }
        });
      });
    

      const deleteButtons = Array.from(document.querySelectorAll(".delete-product"));
      const orderList = document.getElementById("orderList");
      const userList = document.getElementById("userList");
      const registerUserButton = document.getElementById("registerUserButton");
      const newUserAddressInput = document.getElementById("newUserAddress");
      const allowedChains = ["0x539", "0x1691"];
      let contractAdmin = "";

      const loadContractAdmin = async () => {
        try {
          const res = await fetch("/api/contracts/admin");
          const payload = await res.json();
          if (res.ok && payload.success && payload.admin) {
            contractAdmin = payload.admin;
          }
        } catch (err) {
          console.warn("Unable to load contract admin:", err);
          contractAdmin = "";
        }
      };

      loadContractAdmin();

      const getConnectedAccount = async () => {
        if (window.appWallet && window.appWallet.isConnected()) {
          return window.appWallet.getAccount();
        }
        if (window.appWallet) {
          const result = await window.appWallet.connect();
          return result && result.account ? result.account : "";
        }
        if (window.ethereum) {
          const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
          return accounts && accounts[0] ? accounts[0] : "";
        }
        return "";
      };

      const ensureGanacheChain = async () => {
        if (!window.ethereum) {
          return false;
        }
        const chainId = await window.ethereum.request({ method: "eth_chainId" });
        return chainId && allowedChains.includes(String(chainId).toLowerCase());
      };

      const renderOrders = (orders) => {
        if (!orderList) {
          return;
        }
        if (!orders || !orders.length) {
          orderList.innerHTML = `
            <div class="row">
              <div>
                <h4>No orders yet.</h4>
                <p>Orders will appear after customers complete checkout.</p>
              </div>
            </div>
          `;
          return;
        }

        const statusSteps = ["Pending", "Picked Up", "In Transit", "Out For Delivery", "Delivered", "Failed"];
        orderList.innerHTML = orders.map((order) => {
          const badgeStyle = order.statusLabel === "Delivered"
            ? "background:#dcfce7;color:#15803d;"
            : order.statusLabel === "Failed"
              ? "background:#fee2e2;color:#b91c1c;"
              : "background:#fef3c7;color:#b45309;";
          const createdAt = order.createdAt ? new Date(order.createdAt).toLocaleString() : "Unknown";
          const updatedAt = order.lastUpdateTime ? new Date(order.lastUpdateTime).toLocaleString() : "Unknown";
          const currentIndex = statusSteps.indexOf(order.statusLabel);
          return `
            <div class="order-card">
              <div>
                <div class="order-header">
                  <h4 class="order-title">${order.itemDescription || "Marketplace order"}</h4>
                  <span class="order-id">${order.trackingId}</span>
                </div>
                <div class="order-meta">
                  <div>Buyer <span>${order.buyer || "Unknown"}</span></div>
                  <div>Created <span>${createdAt}</span></div>
                  <div>Last update <span>${updatedAt}</span></div>
                </div>
              </div>
              <div>
                <div class="order-amount">
                  <div>
                    <h4>Amount</h4>
                    <strong>${order.shipmentValue} ETH</strong>
                  </div>
                  <span class="status-badge" style="${badgeStyle}">${order.statusLabel}</span>
                </div>
                <div class="status-track">
                  ${statusSteps.map((label, index) => {
                    const stateClass = index === currentIndex ? "current" : index < currentIndex ? "done" : "";
                    return `<span class="status-step ${stateClass}">${label}</span>`;
                  }).join("")}
                </div>
                <div class="status-actions">
                  <select data-status-select="${order.trackingId}" class="status-select">
                    ${statusSteps.map((label, index) => {
                      const selected = index === currentIndex ? "selected" : "";
                      return `<option value="${index}" ${selected}>${label}</option>`;
                    }).join("")}
                  </select>
                  <button class="status-update-btn" data-update-status="${order.trackingId}">Update Status</button>
                </div>
              </div>
            </div>
          `;
        }).join("");
      };

      const formatUserDate = (timestamp) => {
        const seconds = Number(timestamp || 0);
        if (!Number.isFinite(seconds) || seconds <= 0) {
          return "Unknown";
        }
        return new Date(seconds * 1000).toLocaleString();
      };

      const renderUsers = (users) => {
        if (!userList) {
          return;
        }
        if (!users || !users.length) {
          userList.innerHTML = `
            <div class="row">
              <div>
                <h4>No users registered yet.</h4>
                <p>Add a user wallet to register on-chain.</p>
              </div>
            </div>
          `;
          return;
        }

        userList.innerHTML = users.map((user) => {
          const roleLabel = user.role === "super_admin"
            ? "Super Admin"
            : user.role === "admin"
              ? "Admin"
              : "User";
          const roleStyle = user.role === "super_admin"
            ? "background:#fef9c3;color:#ca8a04;"
            : user.role === "admin"
              ? "background:#fff7ed;color:#c2410c;"
              : "";
          const statusText = user.active ? "Active" : "Inactive";
          const statusStyle = user.active
            ? "background:#ecfdf3;color:#16a34a;"
            : "background:#fee2e2;color:#dc2626;";
          const disableDelete = user.isSuperAdmin;
          const actionLabel = user.active ? "Deactivate" : "Reactivate";
          return `
            <div class="row">
              <div>
                <h4>${user.address} <span class="pill" style="${roleStyle}">${roleLabel}</span></h4>
                <p>Status: <span class="pill" style="${statusStyle}">${statusText}</span></p>
                <p>Joined: ${formatUserDate(user.createdAt)} &nbsp;&nbsp; Updated: ${formatUserDate(user.lastUpdated)}</p>
              </div>
              <div class="user-actions">
                <button class="btn-outline user-status-toggle" type="button" data-user-address="${user.address}" data-user-active="${user.active}">
                  ${disableDelete ? "Cannot Modify" : actionLabel}
                </button>
              </div>
            </div>
          `;
        }).join("");
      };

      const loadOrders = async () => {
        if (!orderList) {
          return;
        }
        try {
          const response = await fetch("/api/orders");
          const payload = await response.json();
          if (!response.ok || !payload.success) {
            orderList.innerHTML = `
              <div class="row">
                <div>
                  <h4>Unable to load orders.</h4>
                  <p>${payload.message || "Connect MetaMask and retry."}</p>
                </div>
              </div>
            `;
            return;
          }
          renderOrders(payload.orders);
        } catch (err) {
          orderList.innerHTML = `
            <div class="row">
              <div>
                <h4>Unable to load orders.</h4>
                <p>${err.message || "Try again later."}</p>
              </div>
            </div>
          `;
        }
      };

      const loadUsers = async () => {
        if (!userList) {
          return;
        }
        try {
          const response = await fetch("/api/users");
          const payload = await response.json();
          if (!response.ok || !payload.success) {
            userList.innerHTML = `
              <div class="row">
                <div>
                  <h4>Unable to load users.</h4>
                  <p>${payload.message || "Connect MetaMask and retry."}</p>
                </div>
              </div>
            `;
            return;
          }
          renderUsers(payload.users);
        } catch (err) {
          userList.innerHTML = `
            <div class="row">
              <div>
                <h4>Unable to load users.</h4>
                <p>${err.message || "Try again later."}</p>
              </div>
            </div>
          `;
        }
      };

      deleteButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const productId = button.dataset.productId;
          if (!productId) {
            return;
          }
          if (!confirm("Remove this product from the on-chain catalog?")) {
            return;
          }

          const account = await getConnectedAccount();
          if (!account) {
            alert("Connect MetaMask to delete products.");
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }

          try {
            const response = await fetch("/api/products/tx/delete", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId, account })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to prepare delete transaction.");
              return;
            }
            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });
            window.location.reload();
          } catch (error) {
            alert(error.message || "Unable to delete product.");
          }
        });
      });

      if (orderList) {
        orderList.addEventListener("click", async (event) => {
          const target = event.target;
          if (!target || !(target instanceof HTMLElement)) {
            return;
          }
          const trackingId = target.getAttribute("data-update-status");
          if (!trackingId) {
            return;
          }
          const account = await getConnectedAccount();
          if (!account) {
            alert("Connect MetaMask to update orders.");
            return;
          }
          if (contractAdmin && account.toLowerCase() !== contractAdmin.toLowerCase()) {
            alert(`Connect the contract owner (${contractAdmin}) before updating order status.`);
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }
          const select = orderList.querySelector(`[data-status-select="${trackingId}"]`);
          const status = select ? Number(select.value) : 0;
          const location = "Admin update";
          const notes = "Status updated by admin";

          try {
            const response = await fetch(`/updateStatus/${encodeURIComponent(trackingId)}`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ status, location, notes })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to prepare status update.");
              return;
            }
            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });
            await loadOrders();
          } catch (err) {
            alert(err.message || "Unable to update order.");
          }
        });
      }

      if (registerUserButton && newUserAddressInput) {
        registerUserButton.addEventListener("click", async () => {
          const userAddress = String(newUserAddressInput.value || "").trim();
          if (!userAddress.match(/^0x[a-fA-F0-9]{40}$/)) {
            alert("Enter a valid wallet address.");
            return;
          }
          const account = await getConnectedAccount();
          if (!account) {
            alert("Connect MetaMask to add users.");
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }
          try {
            const response = await fetch("/api/users/tx/register", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ userAddress, account })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to prepare registration.");
              return;
            }
            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });
            newUserAddressInput.value = "";
            await loadUsers();
          } catch (err) {
            alert(err.message || "Unable to add user.");
          }
        });
      }

      if (userList) {
        userList.addEventListener("click", async (event) => {
          const target = event.target;
          if (!target || !(target instanceof HTMLElement)) {
            return;
          }
          if (!target.classList.contains("user-status-toggle")) {
            return;
          }
          const userAddress = target.getAttribute("data-user-address");
          const activeValue = target.getAttribute("data-user-active");
          if (!userAddress) {
            return;
          }
          if (target.textContent.includes("Cannot Modify")) {
            return;
          }
          const account = await getConnectedAccount();
          if (!account) {
            alert("Connect MetaMask to manage users.");
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }
          const nextActive = String(activeValue) !== "true";
          if (!confirm(`${nextActive ? "Reactivate" : "Deactivate"} this account?`)) {
            return;
          }
          try {
            const response = await fetch("/api/users/tx/status", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ userAddress, active: nextActive, account })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to prepare status update.");
              return;
            }
            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });
            await loadUsers();
          } catch (err) {
            alert(err.message || "Unable to update user.");
          }
        });
      }

      loadOrders();
      loadUsers();
</script>
  </body>
</html>
