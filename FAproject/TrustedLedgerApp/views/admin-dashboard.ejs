<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin Dashboard | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #111827;
        --muted: #6b7280;
        --panel: #ffffff;
        --soft: #f3f4f6;
        --border: #e5e7eb;
        --brand: #2f5bf0;
        --green: #16a34a;
        --purple: #8b5cf6;
        --orange: #f97316;
        --shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
        --radius-lg: 16px;
        --radius-md: 12px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        color: var(--ink);
        background: #f5f7fb;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
      }

      .stat-card {
        background: var(--panel);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        box-shadow: var(--shadow);
      }

      .stat-card h4 {
        margin: 0 0 6px;
        font-size: 12px;
        color: var(--muted);
        font-weight: 600;
      }

      .stat-card .value {
        font-size: 22px;
        font-weight: 700;
      }

      .stat-card small {
        font-size: 11px;
        color: var(--muted);
      }

      .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        color: #fff;
      }

      .icon-blue {
        background: #dbe6ff;
        color: var(--brand);
      }

      .icon-green {
        background: #dcfce7;
        color: var(--green);
      }

      .icon-purple {
        background: #ede9fe;
        color: var(--purple);
      }

      .icon-orange {
        background: #ffedd5;
        color: var(--orange);
      }

      .tabs {
        margin-top: 18px;
        background: #ededf1;
        border-radius: 999px;
        padding: 4px;
        display: inline-flex;
        gap: 4px;
      }

      .tab {
        border: none;
        background: transparent;
        padding: 6px 16px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        color: var(--ink);
      }

      .tab.active {
        background: #fff;
        box-shadow: 0 8px 16px rgba(15, 23, 42, 0.08);
      }

      .panel {
        margin-top: 14px;
        background: var(--panel);
        border-radius: var(--radius-lg);
        border: 1px solid var(--border);
        padding: 16px;
        box-shadow: var(--shadow);
      }

      .panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 12px;
      }

      .panel-header h3 {
        margin: 0;
        font-size: 14px;
      }

      .btn {
        border: none;
        padding: 6px 12px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        background: #0b1020;
        color: #fff;
        cursor: pointer;
      }

      .search {
        width: 100%;
        border: 1px solid var(--border);
        background: var(--soft);
        border-radius: 8px;
        padding: 8px 10px;
        font-size: 12px;
        margin-bottom: 12px;
      }

      .list {
        display: grid;
        gap: 10px;
      }

      .row {
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px;
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 12px;
        align-items: center;
      }

      .thumb {
        width: 46px;
        height: 46px;
        border-radius: 8px;
        background: #f3f4f6;
        object-fit: cover;
      }

      .row h4 {
        margin: 0 0 4px;
        font-size: 13px;
      }

      .row p {
        margin: 0;
        font-size: 11px;
        color: var(--muted);
      }

      .pill {
        display: inline-flex;
        align-items: center;
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 10px;
        font-weight: 600;
        background: #f3f4ff;
        color: var(--brand);
      }

      .action-buttons {
        display: inline-flex;
        gap: 6px;
      }

      .icon-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: 1px solid var(--border);
        background: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-size: 12px;
      }

      .panel-section {
        display: none;
      }

      .panel-section.active {
        display: block;
      }

      .user-actions {
        display: inline-flex;
        gap: 8px;
      }

      .btn-outline {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--ink);
        padding: 4px 10px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 600;
      }

      .info-box {
        margin-top: 12px;
        border: 1px solid #bfdbfe;
        background: #eff6ff;
        border-radius: 10px;
        padding: 10px;
        font-size: 11px;
        color: #1e3a8a;
        line-height: 1.6;
      }

      @media (max-width: 980px) {
        .stat-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      @media (max-width: 720px) {
        .stat-grid {
          grid-template-columns: 1fr;
        }

        .row {
          grid-template-columns: 1fr;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <section class="stat-grid">
        <div class="stat-card">
          <div>
            <h4>Total Products</h4>
            <div class="value"><%= products ? products.length : 0 %></div>
          </div>
          <div class="stat-icon icon-blue">▣</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Orders</h4>
            <div class="value">3</div>
            <small>1 pending</small>
          </div>
          <div class="stat-icon icon-green">▤</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Users</h4>
            <div class="value">2</div>
            <small>2 admins</small>
          </div>
          <div class="stat-icon icon-purple">◉</div>
        </div>
        <div class="stat-card">
          <div>
            <h4>Total Revenue</h4>
            <div class="value">$548.89</div>
            <small>1 completed</small>
          </div>
          <div class="stat-icon icon-orange">▥</div>
        </div>
      </section>

      <div class="tabs" role="tablist">
        <button class="tab active" type="button" data-tab="products">Products</button>
        <button class="tab" type="button" data-tab="orders">Orders</button>
        <button class="tab" type="button" data-tab="users">Users</button>
      </div>

      <section class="panel panel-section active" data-panel="products">
        <div class="panel-header">
          <h3>Product Management</h3>
          <a class="btn" href="/addproduct">Add Product</a>
        </div>
        <input class="search" placeholder="Search products..." />
        <div class="list">
          <% if (products && products.length) { %>
            <% products.forEach((product) => { %>
              <div class="row">
                <img class="thumb" src="<%= product.images && product.images.length ? product.images[0] : '/images/default-product.jpeg' %>" alt="Product" />
                <div>
                  <h4><%= product.productInfo.name %> <span class="pill"><%= product.productInfo.category %></span></h4>
                  <p><%= product.productInfo.description %></p>
                  <p>$<%= product.productInfo.price %> ETHR &nbsp;&nbsp; Stock <%= product.stock %> &nbsp;&nbsp; ID: <%= product.id %></p>
                </div>
                <div class="action-buttons">
                  <button class="icon-btn delete-product" type="button" data-product-id="<%= product.id %>">Del</button>
                </div>
              </div>
            <% }) %>
          <% } else { %>
            <div class="row">
              <div>
                <h4>No products on-chain yet.</h4>
                <p>Add a product to initialize the on-chain catalog.</p>
              </div>
            </div>
          <% } %>
        </div>
      </section>

      <section class="panel panel-section" data-panel="orders">
        <div class="panel-header">
          <h3>Order Management</h3>
        </div>
        <div class="list" id="orderList">
          <div class="row">
            <div>
              <h4>Loading orders...</h4>
              <p>Connect MetaMask with the admin account to view on-chain orders.</p>
            </div>
          </div>
        </div>
      </section>

      <section class="panel panel-section" data-panel="users">
        <div class="panel-header">
          <h3>User Management</h3>
          <span class="pill" style="background:#fff7ed;color:#c2410c;">Limited Access - Super Admin Required for Promotion</span>
        </div>
        <input class="search" placeholder="Search users by name, email, or role..." />
        <div class="list">
          <div class="row">
            <div>
              <h4>John Doe <span class="pill">User</span></h4>
              <p>user@example.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 15/01/2024</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button">Promote to Admin</button>
              <button class="btn-outline" type="button" style="color:#dc2626;border-color:#fecaca;">Deactivate</button>
            </div>
          </div>
          <div class="row">
            <div>
              <h4>Admin User <span class="pill" style="background:#fff7ed;color:#c2410c;">Admin</span></h4>
              <p>admin@blockchaintrack.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 20/11/2023</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button">Demote to User</button>
              <button class="btn-outline" type="button" style="color:#dc2626;border-color:#fecaca;">Deactivate</button>
            </div>
          </div>
          <div class="row">
            <div>
              <h4>Super Administrator <span class="pill" style="background:#fef9c3;color:#ca8a04;">Super Admin</span></h4>
              <p>superadmin@blockchaintrack.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 01/01/2023</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button" style="color:#a16207;border-color:#fde68a;">Cannot Modify</button>
            </div>
          </div>
          <div class="row">
            <div>
              <h4>Sarah Chen <span class="pill">User</span></h4>
              <p>sarah@example.com</p>
              <p>Wallet: Not connected &nbsp;&nbsp; Joined: 10/03/2024</p>
            </div>
            <div class="user-actions">
              <button class="btn-outline" type="button">Promote to Admin</button>
              <button class="btn-outline" type="button" style="color:#dc2626;border-color:#fecaca;">Deactivate</button>
            </div>
          </div>
        </div>
        <div class="info-box">
          <strong>User Management Rules:</strong><br />
          - Super Admin can promote users to admin and demote admins<br />
          - Regular Admin can view users but cannot change roles<br />
          - Super Admin account cannot be demoted or deactivated<br />
          - Deactivated users cannot login to the system
        </div>
      </section>
    </main>

    <script>
      const tabs = Array.from(document.querySelectorAll(".tab"));
      const panels = Array.from(document.querySelectorAll(".panel-section"));

      tabs.forEach((tab) => {
        tab.addEventListener("click", () => {
          tabs.forEach((t) => t.classList.remove("active"));
          panels.forEach((panel) => panel.classList.remove("active"));
          tab.classList.add("active");
          const target = tab.dataset.tab;
          const panel = document.querySelector(`[data-panel="${target}"]`);
          if (panel) {
            panel.classList.add("active");
          }
        });
      });
    

      const deleteButtons = Array.from(document.querySelectorAll(".delete-product"));
      const orderList = document.getElementById("orderList");
      const allowedChains = ["0x539", "0x1691"];
      let contractAdmin = "";

      const loadContractAdmin = async () => {
        try {
          const res = await fetch("/api/contracts/admin");
          const payload = await res.json();
          if (res.ok && payload.success && payload.admin) {
            contractAdmin = payload.admin;
          }
        } catch (err) {
          console.warn("Unable to load contract admin:", err);
          contractAdmin = "";
        }
      };

      loadContractAdmin();

      const getConnectedAccount = async () => {
        if (window.appWallet && window.appWallet.isConnected()) {
          return window.appWallet.getAccount();
        }
        if (window.appWallet) {
          const result = await window.appWallet.connect();
          return result && result.account ? result.account : "";
        }
        if (window.ethereum) {
          const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
          return accounts && accounts[0] ? accounts[0] : "";
        }
        return "";
      };

      const ensureGanacheChain = async () => {
        if (!window.ethereum) {
          return false;
        }
        const chainId = await window.ethereum.request({ method: "eth_chainId" });
        return chainId && allowedChains.includes(String(chainId).toLowerCase());
      };

      const renderOrders = (orders) => {
        if (!orderList) {
          return;
        }
        if (!orders || !orders.length) {
          orderList.innerHTML = `
            <div class="row">
              <div>
                <h4>No orders yet.</h4>
                <p>Orders will appear after customers complete checkout.</p>
              </div>
            </div>
          `;
          return;
        }

        orderList.innerHTML = orders.map((order) => {
          const badgeStyle = order.statusLabel === "Delivered"
            ? "background:#ecfdf3;color:#16a34a;"
            : order.statusLabel === "Failed"
              ? "background:#fee2e2;color:#dc2626;"
              : "background:#fef9c3;color:#ca8a04;";
          return `
            <div class="row">
              <div>
                <h4>${order.itemDescription || "Order"} <span class="pill">${order.trackingId}</span></h4>
                <p>Buyer: ${order.buyer}</p>
                <p>${new Date(order.createdAt).toLocaleString()}</p>
              </div>
              <div>
                <p>Amount</p>
                <p><strong>${order.shipmentValue} ETH</strong> <span class="pill" style="${badgeStyle}">${order.statusLabel}</span></p>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px;">
                  <select data-status-select="${order.trackingId}" class="btn-outline">
                    <option value="0">Pending</option>
                    <option value="1">Picked Up</option>
                    <option value="2">In Transit</option>
                    <option value="3">Out For Delivery</option>
                    <option value="4">Delivered</option>
                    <option value="5">Failed</option>
                  </select>
                  <button class="btn-outline" data-update-status="${order.trackingId}">Update</button>
                </div>
              </div>
            </div>
          `;
        }).join("");
      };

      const loadOrders = async () => {
        if (!orderList) {
          return;
        }
        try {
          const response = await fetch("/api/orders");
          const payload = await response.json();
          if (!response.ok || !payload.success) {
            orderList.innerHTML = `
              <div class="row">
                <div>
                  <h4>Unable to load orders.</h4>
                  <p>${payload.message || "Connect MetaMask and retry."}</p>
                </div>
              </div>
            `;
            return;
          }
          renderOrders(payload.orders);
        } catch (err) {
          orderList.innerHTML = `
            <div class="row">
              <div>
                <h4>Unable to load orders.</h4>
                <p>${err.message || "Try again later."}</p>
              </div>
            </div>
          `;
        }
      };

      deleteButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const productId = button.dataset.productId;
          if (!productId) {
            return;
          }
          if (!confirm("Remove this product from the on-chain catalog?")) {
            return;
          }

          const account = await getConnectedAccount();
          if (!account) {
            alert("Connect MetaMask to delete products.");
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }

          try {
            const response = await fetch("/api/products/tx/delete", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId, account })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to prepare delete transaction.");
              return;
            }
            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });
            window.location.reload();
          } catch (error) {
            alert(error.message || "Unable to delete product.");
          }
        });
      });

      if (orderList) {
        orderList.addEventListener("click", async (event) => {
          const target = event.target;
          if (!target || !(target instanceof HTMLElement)) {
            return;
          }
          const trackingId = target.getAttribute("data-update-status");
          if (!trackingId) {
            return;
          }
          const account = await getConnectedAccount();
          if (!account) {
            alert("Connect MetaMask to update orders.");
            return;
          }
          if (contractAdmin && account.toLowerCase() !== contractAdmin.toLowerCase()) {
            alert(`Connect the contract owner (${contractAdmin}) before updating order status.`);
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }
          const select = orderList.querySelector(`[data-status-select="${trackingId}"]`);
          const status = select ? Number(select.value) : 0;
          const location = "Admin update";
          const notes = "Status updated by admin";

          try {
            const response = await fetch(`/updateStatus/${encodeURIComponent(trackingId)}`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ status, location, notes })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to prepare status update.");
              return;
            }
            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });
            await loadOrders();
          } catch (err) {
            alert(err.message || "Unable to update order.");
          }
        });
      }

      loadOrders();
</script>
  </body>
</html>
