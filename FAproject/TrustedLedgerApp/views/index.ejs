<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Blockchain Marketplace</title>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

    :root {
      --blue-600: #2563eb;
      --blue-700: #1d4ed8;
      --blue-50: #eff6ff;
      --green-600: #16a34a;
      --gray-50: #f9fafb;
      --gray-100: #f3f4f6;
      --gray-200: #e5e7eb;
      --gray-500: #6b7280;
      --gray-600: #4b5563;
      --gray-700: #374151;
      --gray-900: #111827;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
      color: var(--gray-900);
      background: radial-gradient(circle at top, #f4f6ff 0%, #ffffff 55%, #eef2ff 100%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 20px 60px;
    }

    .hero {
      margin-top: 24px;
      padding: 48px 36px;
      border-radius: 24px;
      background: linear-gradient(135deg, #1e40af 0%, #2563eb 55%, #3b82f6 100%);
      color: #fff;
      position: relative;
      overflow: hidden;
    }

    .hero::after {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.25), transparent 70%);
      top: -140px;
      right: -140px;
    }

    .hero h1 {
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(2.2rem, 4vw, 3.2rem);
      margin: 0 0 12px;
      max-width: 620px;
    }

    .hero p {
      margin: 0 0 20px;
      font-size: 16px;
      line-height: 1.6;
      max-width: 520px;
      color: rgba(255, 255, 255, 0.88);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: center;
    }

    .search {
      background: rgba(255, 255, 255, 0.15);
      border: 1px solid rgba(255, 255, 255, 0.35);
      padding: 12px 16px;
      border-radius: 999px;
      color: #fff;
      min-width: 260px;
      outline: none;
    }

    .search::placeholder {
      color: rgba(255, 255, 255, 0.7);
    }

    .primary-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border-radius: 999px;
      background: #fff;
      color: #1e3a8a;
      font-weight: 600;
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.2);
    }

    .products {
      margin-top: 36px;
    }

    .products-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 20px;
    }

    .products-header h2 {
      margin: 0;
      font-size: 24px;
    }

    .loading {
      color: var(--gray-600);
      font-size: 14px;
      margin-bottom: 18px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: #fff;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--gray-200);
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .card img {
      width: 100%;
      height: 200px;
      object-fit: cover;
    }

    .card-body {
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      background: var(--blue-50);
      color: var(--blue-700);
      font-weight: 600;
    }

    .price {
      font-size: 18px;
      font-weight: 700;
      color: var(--blue-600);
    }

    .stock {
      font-size: 12px;
      color: var(--green-600);
    }

    .btn {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 12px;
      border-radius: 10px;
      background: var(--blue-600);
      color: #fff;
      font-weight: 600;
      border: none;
    }

    .empty {
      background: #fff;
      border: 1px dashed var(--gray-200);
      padding: 24px;
      border-radius: 16px;
      color: var(--gray-600);
    }

    @media (max-width: 720px) {
      .hero {
        padding: 36px 24px;
      }

      .products-header {
        flex-direction: column;
        align-items: flex-start;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/navbar', { acct }) %>

  <div class="page">
    <section class="hero">
      <h1>Blockchain-Secured Marketplace</h1>
      <p>Every product is transparently tracked on blockchain with verifiable provenance.</p>
      <div class="hero-actions">
        <input class="search" placeholder="Search products..." />
        <a href="/products" class="primary-btn">View All Products</a>
        <% if (userRole === 'admin' || userRole === 'super_admin') { %>
          <a href="/addproduct" class="primary-btn">Add Product</a>
        <% } %>
      </div>
    </section>

    <section class="products">
      <div class="products-header">
        <h2>Featured Products</h2>
        <span style="color: var(--gray-500); font-size: 14px;">Updated in real time</span>
      </div>

      <% if (status) { %>
        <p class="loading">Loading blockchain data...</p>
      <% } %>

      <% if (!products || products.length === 0) { %>
        <div class="empty">No products yet. Add the first product to start the marketplace.</div>
      <% } else { %>
        <div class="grid">
          <% products.forEach(item => { %>
            <div class="card">
              <% const img = item.images && item.images.length ? item.images[0] : '/images/default-product.jpeg'; %>
              <img src="<%= img %>" alt="<%= item.productInfo.name %>">

              <div class="card-body">
                <span class="badge"><%= item.productInfo.category || "Verified" %></span>
                <h3 style="margin: 0;"><%= item.productInfo.name %></h3>
                <p style="margin: 0; color: var(--gray-600);"><%= item.productInfo.description %></p>
                <div class="price">$<%= item.productInfo.price %> ETHR</div>
                <div class="stock"><%= item.status %> ? <%= item.stock %> in stock</div>
                <a class="btn" href="/product/<%= item.id %>">View Details</a>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>
  </div>
</body>
</html>
