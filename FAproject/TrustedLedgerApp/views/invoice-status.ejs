<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Invoice Verification</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --green: #16a34a;
        --red: #dc2626;
        --ink: #0f172a;
        --muted: #64748b;
        --panel: #ffffff;
        --shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        background: radial-gradient(circle at top, #eef2ff 0%, #ffffff 55%, #f3f7ff 100%);
        color: var(--ink);
        min-height: 100vh;
      }

      .page {
        max-width: 960px;
        margin: 0 auto;
        padding: 32px 20px 60px;
      }

      .card {
        background: var(--panel);
        border-radius: 20px;
        padding: 26px;
        box-shadow: var(--shadow);
        border: 1px solid #e2e8f0;
        text-align: center;
      }

      .badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 72px;
        height: 72px;
        border-radius: 50%;
        font-size: 32px;
        margin-bottom: 16px;
      }

      .badge.success {
        background: rgba(22, 163, 74, 0.12);
        color: var(--green);
      }

      .badge.fail {
        background: rgba(220, 38, 38, 0.12);
        color: var(--red);
      }

      h1 {
        font-family: "Fraunces", Georgia, serif;
        margin: 0 0 12px;
      }

      p {
        margin: 0;
        color: var(--muted);
      }

      .actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        margin-top: 20px;
        flex-wrap: wrap;
      }

      .btn {
        border: none;
        border-radius: 999px;
        padding: 10px 16px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
      }

      .btn-primary {
        background: #2563eb;
        color: #fff;
      }

      .btn-outline {
        border: 1px solid #cbd5f5;
        background: #fff;
        color: #2563eb;
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <section class="card">
        <% if (status === "approved") { %>
          <div class="badge success">&#10003;</div>
          <h1>Invoice Verified</h1>
          <p>Invoice authenticity confirmed on-chain for tracking ID <strong><%= trackingId || "N/A" %></strong>.</p>
        <% } else { %>
          <div class="badge fail">&#10007;</div>
          <h1>Invoice Not Authentic</h1>
          <p>The uploaded invoice does not match the on-chain purchase for <strong><%= trackingId || "N/A" %></strong>.</p>
        <% } %>

        <div class="actions">
          <a class="btn btn-primary" href="/documents">Back to Documents</a>
          <a class="btn btn-outline" href="/orders">View Orders</a>
        </div>
      </section>
    </main>
  </body>
</html>
