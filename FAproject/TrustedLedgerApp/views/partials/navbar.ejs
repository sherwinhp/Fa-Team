<!-- NAVBAR -->
<style>
  :root {
    --app-bg: #eef2ff;
    --card-bg: #ffffff;
    --card-border: rgba(59, 130, 246, 0.25);
    --shadow-soft: 0 20px 45px rgba(15, 23, 42, 0.08);
    --text-primary: #0f172a;
    --text-muted: #475569;
    --primary: #2563eb;
    --primary-soft: #e0e7ff;
  }

  body {
    font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
    background: var(--app-bg);
    color: var(--text-primary);
    margin: 0;
    min-height: 100vh;
  }

  img {
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
    display: block;
  }

  .page {
    background: transparent;
    padding: 0;
  }

  .section-card {
    background: var(--card-bg);
    border: 1px solid var(--card-border);
    border-radius: 20px;
    padding: 28px;
    box-shadow: var(--shadow-soft);
  }

  .btn, .btn-primary, .btn-outline {
    border-radius: 999px;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .btn:hover, .btn-primary:hover, .btn-outline:hover {
    transform: translateY(-1px);
    box-shadow: 0 10px 30px rgba(15, 23, 42, 0.15);
  }

/* =========================
   TOP NAVBAR (INLINE)
========================= */

.top-nav {
  background: rgba(255, 255, 255, 0.65);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  position: sticky;
  top: 0;
  z-index: 20;
  box-shadow: 0 10px 35px rgba(15, 23, 42, 0.1);
}

.nav-container {
  max-width: 1300px;
  margin: 0 auto;
  padding: 12px 28px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18px;
}

.brand-pill {
  display: flex;
  align-items: center;
  gap: 10px;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  padding: 10px 18px;
  border-radius: 14px;
  font-weight: 700;
  font-size: 15px;
  box-shadow: 0 12px 30px rgba(37, 99, 235, 0.25);
}

.brand-pill span {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.nav-menu {
  display: flex;
  align-items: center;
  gap: 28px;
  flex-wrap: nowrap;
  justify-content: space-between;
}

.nav-menu-left {
  display: flex;
  align-items: center;
  gap: 16px;
  flex-wrap: wrap;
}

.nav-admin {
  width: 100%;
  justify-content: center;
}

.nav-admin .nav-link {
  font-size: 15px;
  padding: 10px 20px;
  background: rgba(15, 23, 42, 0.08);
  border-radius: 12px;
}

.nav-link {
  text-decoration: none;
  color: #1f2937;
  font-size: 14px;
  font-weight: 600;
  padding: 8px 12px;
  border-radius: 10px;
  transition: background 0.2s ease, color 0.2s ease;
}

.nav-link:hover {
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
}

.nav-link.active {
  background: rgba(37, 99, 235, 0.12);
  color: #1d4ed8;
}

.nav-actions {
  display: inline-flex;
  align-items: center;
  gap: 12px;
}

.nav-button,
.nav-link.custom {
  border: 1px solid #e0e7ff;
  border-radius: 999px;
  padding: 8px 14px;
  font-weight: 600;
  cursor: pointer;
  transition: transform 0.2s ease;
}

.nav-button.primary {
  background: linen;
}

.nav-button:hover,
.nav-link.custom:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.12);
}

.nav-secure {
  display: flex;
  align-items: center;
  gap: 6px;
  background: #ecfdf5;
  color: #059669;
  padding: 6px 14px;
  border-radius: 999px;
  font-size: 13px;
  font-weight: 600;
}

.nav-secure span {
  font-size: 14px;
}
</style>

<!-- NAVBAR -->
<header class="top-nav">
  <div class="nav-container">

    <!-- Left: Logo -->
    <div class="brand">
      <div class="brand-pill">
        <span class="cube">⬡</span>
        <span class="brand-text">BlockChain Track</span>
      </div>
    </div>

    <!-- Right: Nav Items -->
    <nav class="nav-menu <%= userRole === 'admin' ? 'nav-admin' : '' %>">
      <div class="nav-menu-left">
        <% if (userRole === 'admin') { %>
          <a href="/" class="nav-link">Marketplace</a>
          <a href="/products" class="nav-link">Products</a>
          <a href="/orders" class="nav-link">Orders</a>
          <a href="/wallet" class="nav-link">Wallet</a>
          <a href="/cart" class="nav-link">Cart</a>
          <a href="/documents" class="nav-link">Documents</a>
          <a href="/about" class="nav-link">About Us</a>
          <a href="/admin" class="nav-link active">Admin</a>
        <% } else { %>
          <a href="/" class="nav-link active">Marketplace</a>
          <a href="/products" class="nav-link">Products</a>
          <% if (isLoggedIn) { %>
            <a href="/orders" class="nav-link">Orders</a>
            <a href="/wallet" class="nav-link">Wallet</a>
            <a href="/cart" class="nav-link">Cart</a>
            <a href="/documents" class="nav-link">Documents</a>
          <% } %>
          <a href="/about" class="nav-link">About Us</a>
        <% } %>
      </div>
      <div class="nav-actions">
        <% if (isLoggedIn) { %>
          <form class="nav-form" action="/logout" method="post">
            <button class="nav-button" type="submit">Logout</button>
          </form>
        <% } else { %>
          <a href="/login" class="nav-link custom">Login</a>
        <% } %>
        <% if (isLoggedIn) { %>
          <button
            class="nav-connect"
            id="connectWalletButton"
            type="button"
            data-allowed='<%- JSON.stringify(ganacheAccounts || []) %>'
            data-chainids='<%- JSON.stringify(ganacheChainIds || []) %>'
            data-provider="<%= ganacheProviderUrl || '' %>"
          >
            Connect MetaMask
          </button>
        <% } %>
        <div class="nav-secure">
          <span class="secure-icon">Secure</span>
          Blockchain Secured
        </div>
      </div>
    </nav>



  </div>
</header>

<script>
  (() => {
    const connectButton = document.getElementById("connectWalletButton");
    const statusEl = document.getElementById("walletStatus");
    let isConnected = false;
    let currentAccount = "";
    let manualDisconnect = false;
    const storageKey = "walletConnected";

    if (!connectButton) {
      return;
    }

    const safeParse = (value, fallback) => {
      if (!value) {
        return fallback;
      }
      try {
        return JSON.parse(value);
      } catch (err) {
        return fallback;
      }
    };

    const allowedAccounts = safeParse(connectButton.dataset.allowed, [])
      .map((item) => String(item || "").toLowerCase())
      .filter(Boolean);
    let allowedChainIds = safeParse(connectButton.dataset.chainids, [])
      .map((item) => String(item || "").toLowerCase())
      .filter(Boolean);
    if (!allowedChainIds.length) {
      allowedChainIds = ["1337", "5777"];
    }
    const providerUrl = connectButton.dataset.provider || "";

    const toHexChainId = (value) => {
      if (!value) {
        return "";
      }
      if (value.startsWith("0x")) {
        return value.toLowerCase();
      }
      const numeric = Number.parseInt(value, 10);
      if (Number.isNaN(numeric)) {
        return "";
      }
      return `0x${numeric.toString(16)}`;
    };

    const allowedChainHex = allowedChainIds
      .map((value) => toHexChainId(value))
      .filter(Boolean);

    const shortAddress = (address) => {
      if (!address || address.length < 10) {
        return address || "";
      }
      return `${address.slice(0, 6)}...${address.slice(-4)}`;
    };

    const emitStatus = (connected, account, message) => {
      if (connected) {
        window.dispatchEvent(new CustomEvent("wallet:connected", { detail: { account } }));
      } else {
        window.dispatchEvent(new CustomEvent("wallet:disconnected", { detail: { message } }));
      }
    };

    const updateButton = (connected) => {
      connectButton.textContent = connected ? "Disconnect MetaMask" : "Connect MetaMask";
    };

    const setStatus = (message, connected, account) => {
      if (statusEl) {
        statusEl.textContent = message;
        statusEl.dataset.connected = connected ? "true" : "false";
      }
      isConnected = connected;
      updateButton(connected);
      emitStatus(connected, account, message);
    };

    const validateConnection = async (account) => {
      if (!window.ethereum) {
        return { ok: false, message: "MetaMask not detected" };
      }
      const chainId = await window.ethereum.request({ method: "eth_chainId" });
      if (allowedChainHex.length && !allowedChainHex.includes(String(chainId).toLowerCase())) {
        return { ok: false, message: "Wrong network (use Ganache)" };
      }
      if (allowedAccounts.length && !allowedAccounts.includes(account.toLowerCase())) {
        return { ok: false, message: "Wrong account (match Ganache)" };
      }
      return { ok: true, chainId };
    };

    const refreshStatus = async () => {
      if (!window.ethereum) {
        setStatus("MetaMask not detected", false);
        return;
      }
      if (manualDisconnect) {
        setStatus("Not connected", false);
        return;
      }
      if (sessionStorage.getItem(storageKey) !== "true") {
        setStatus("Not connected", false);
        return;
      }
      try {
        const accounts = await window.ethereum.request({ method: "eth_accounts" });
        const active = accounts && accounts[0] ? accounts[0] : "";
        if (!active) {
          currentAccount = "";
          sessionStorage.removeItem(storageKey);
          setStatus("Not connected", false);
          return;
        }
        const validation = await validateConnection(active);
        if (!validation.ok) {
          currentAccount = "";
          setStatus(validation.message, false);
          return;
        }
        currentAccount = active;
        setStatus(`${shortAddress(active)}`, true, active);
      } catch (err) {
        currentAccount = "";
        sessionStorage.removeItem(storageKey);
        setStatus("Not connected", false);
      }
    };

    updateButton(false);
    refreshStatus();

    const connectWallet = async () => {
      if (!window.ethereum) {
        setStatus("MetaMask not detected", false);
        return null;
      }

      try {
        manualDisconnect = false;
        const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
        const account = (accounts && accounts[0]) ? accounts[0] : "";

        if (!account) {
          setStatus("No account selected", false);
          return null;
        }

        const validation = await validateConnection(account);
        if (!validation.ok) {
          setStatus(validation.message, false);
          return null;
        }

        currentAccount = account;
        sessionStorage.setItem(storageKey, "true");
        setStatus(`${shortAddress(account)}`, true, account);

        try {
          const contractResponse = await fetch("/build/ShippingTrackerContract.json");
          if (!contractResponse.ok) {
            return;
          }
          const contractInfo = await contractResponse.json();
          const chainDecimal = Number.parseInt(validation.chainId, 16);
          const networks = contractInfo && contractInfo.networks ? contractInfo.networks : {};
          const networkInfo = networks[chainDecimal] || networks[String(chainDecimal)];
          const contractAddress = networkInfo && networkInfo.address ? networkInfo.address : "";

          await fetch("/web3Connect", {
            method: "POST",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              contractAddress: contractAddress || "",
              acct: account,
              providerUrl: providerUrl || undefined
            })
          });
        } catch (err) {
          console.error("MetaMask connect error:", err);
        }
        return { account, chainId: validation.chainId };
      } catch (err) {
        setStatus("Connection canceled", false);
        return null;
      }
    };

    const disconnectWallet = async () => {
      manualDisconnect = true;
      currentAccount = "";
      sessionStorage.removeItem(storageKey);
      if (window.ethereum && window.ethereum.request) {
        try {
          await window.ethereum.request({
            method: "wallet_revokePermissions",
            params: [{ eth_accounts: {} }]
          });
        } catch (err) {
          // MetaMask may not support revoke; keep UI disconnected.
        }
      }
      setStatus("Not connected", false);
      return true;
    };

    window.appWallet = {
      connect: connectWallet,
      disconnect: disconnectWallet,
      isConnected: () => isConnected,
      getAccount: () => currentAccount
    };

    connectButton.addEventListener("click", (event) => {
      event.preventDefault();
      if (isConnected) {
        disconnectWallet();
        return;
      }
      connectWallet();
    });

    if (window.ethereum && window.ethereum.on) {
      window.ethereum.on("accountsChanged", () => refreshStatus());
      window.ethereum.on("chainChanged", () => refreshStatus());
    }
  })();
</script>
