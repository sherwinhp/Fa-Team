<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Orders | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #111827;
        --muted: #6b7280;
        --panel: #ffffff;
        --soft: #f3f4f6;
        --border: #e5e7eb;
        --brand: #2563eb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        background: #f5f7fb;
        color: var(--ink);
      }

      .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }

      .card {
        background: var(--panel);
        border-radius: 16px;
        border: 1px solid var(--border);
        padding: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
      }

      .row {
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 14px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 12px;
        align-items: center;
      }

      .row + .row {
        margin-top: 12px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: #f3f4ff;
        color: var(--brand);
      }

      .status {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
      }

      .status-pending {
        background: #fef9c3;
        color: #ca8a04;
      }

      .status-delivered {
        background: #dcfce7;
        color: #16a34a;
      }

      .status-failed {
        background: #fee2e2;
        color: #dc2626;
      }

      .btn {
        border: none;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 600;
        background: var(--brand);
        color: #fff;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .empty {
        border: 1px dashed var(--border);
        padding: 24px;
        border-radius: 14px;
        color: var(--muted);
        background: #fff;
      }

      .muted {
        color: var(--muted);
        font-size: 13px;
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <div class="header">
        <h1 style="margin: 0;">Your Orders</h1>
      </div>

      <section class="card">
        <div id="ordersList" class="list">
          <div class="row">
            <div>
              <strong>Loading orders…</strong>
              <div class="muted">Connect MetaMask to load your on-chain order history.</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      const ordersList = document.getElementById("ordersList");

      const statusClass = (status) => {
        if (status === "Delivered") return "status-delivered";
        if (status === "Failed") return "status-failed";
        return "status-pending";
      };

      const renderOrders = (orders) => {
        if (!ordersList) return;
        if (!orders || !orders.length) {
          ordersList.innerHTML = `
            <div class="empty">No orders yet. Purchase a product to see it here.</div>
          `;
          return;
        }
        ordersList.innerHTML = orders.map((order) => {
          const date = order.createdAt ? new Date(order.createdAt).toLocaleString() : "Unknown";
          return `
            <div class="row">
              <div>
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                  <strong>${order.itemDescription || "Order"}</strong>
                  <span class="pill">${order.trackingId}</span>
                  <span class="status ${statusClass(order.statusLabel)}">${order.statusLabel}</span>
                </div>
                <div class="muted">Placed: ${date}</div>
                <div class="muted">Seller: ${order.seller}</div>
                <div class="muted">Amount: ${order.shipmentValue} ETH</div>
              </div>
              <a class="btn" href="/shipping/tracker?trackingId=${encodeURIComponent(order.trackingId)}">Track</a>
            </div>
          `;
        }).join("");
      };

      const loadOrders = async () => {
        if (!ordersList) return;
        try {
          const res = await fetch("/api/orders/user");
          const payload = await res.json();
          if (!res.ok || !payload.success) {
            ordersList.innerHTML = `
              <div class="empty">${payload.message || "Unable to load orders."}</div>
            `;
            return;
          }
          renderOrders(payload.orders);
        } catch (err) {
          ordersList.innerHTML = `
            <div class="empty">${err.message || "Unable to load orders."}</div>
          `;
        }
      };

      loadOrders();
      setInterval(loadOrders, 10000);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) {
          loadOrders();
        }
      });
    </script>
  </body>
</html>
