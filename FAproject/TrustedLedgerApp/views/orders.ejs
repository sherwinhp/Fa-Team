<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Orders | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #0f172a;
        --muted: #64748b;
        --panel: #ffffff;
        --soft: #f1f5f9;
        --border: #e2e8f0;
        --brand: #1d4ed8;
        --accent: #22d3ee;
        --shadow: 0 20px 40px rgba(15, 23, 42, 0.12);
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        background: radial-gradient(circle at top, #eef2ff 0%, #ffffff 55%, #f1f5ff 100%);
        color: var(--ink);
      }

      .hero {
        background: linear-gradient(120deg, #1e3a8a 0%, #1d4ed8 55%, #22d3ee 100%);
        color: #fff;
        padding: 42px 24px 48px;
        position: relative;
        overflow: hidden;
      }

      .hero::after {
        content: "";
        position: absolute;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.25), transparent 70%);
        top: -140px;
        right: -120px;
      }

      .hero-inner {
        max-width: 1100px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
      }

      .hero h1 {
        margin: 0 0 8px;
        font-family: "Fraunces", Georgia, serif;
        font-size: clamp(1.9rem, 3vw, 2.5rem);
      }

      .hero p {
        margin: 0;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.85);
      }

      .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 26px 20px 70px;
      }

      .card {
        background: var(--panel);
        border-radius: 18px;
        border: 1px solid var(--border);
        padding: 20px;
        box-shadow: var(--shadow);
      }

      .row {
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 16px;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 14px;
        align-items: center;
        background: #fff;
        box-shadow: 0 12px 24px rgba(15, 23, 42, 0.06);
        position: relative;
        overflow: hidden;
      }

      .row::before {
        content: "";
        position: absolute;
        inset: 12px auto 12px 12px;
        width: 4px;
        border-radius: 999px;
        background: linear-gradient(180deg, var(--brand), var(--accent));
      }

      .row + .row {
        margin-top: 12px;
      }

      .row:hover {
        transform: translateY(-2px);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        box-shadow: 0 16px 30px rgba(15, 23, 42, 0.12);
      }

      .row-content {
        padding-left: 18px;
      }

      .pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        background: #e0e7ff;
        color: var(--brand);
      }

      .status {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
      }

      .status-pending {
        background: #fef9c3;
        color: #ca8a04;
      }

      .status-delivered {
        background: #dcfce7;
        color: #16a34a;
      }

      .status-failed {
        background: #fee2e2;
        color: #dc2626;
      }

      .btn {
        border: none;
        border-radius: 999px;
        padding: 9px 14px;
        font-weight: 600;
        background: var(--brand);
        color: #fff;
        cursor: pointer;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }

      .btn.ghost {
        background: #fff;
        color: var(--brand);
        border: 1px solid #c7d2fe;
      }

      .btn.success {
        background: #10b981;
      }

      .order-actions {
        display: flex;
        flex-direction: column;
        gap: 8px;
        align-items: flex-end;
      }

      .empty {
        border: 1px dashed var(--border);
        padding: 24px;
        border-radius: 14px;
        color: var(--muted);
        background: #fff;
      }

      .muted {
        color: var(--muted);
        font-size: 13px;
      }

      .meta {
        display: grid;
        gap: 4px;
        margin-top: 6px;
      }

      .hash {
        word-break: break-all;
      }

      @media (max-width: 720px) {
        .row {
          grid-template-columns: 1fr;
        }
        .order-actions {
          align-items: stretch;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <section class="hero">
      <div class="hero-inner">
        <h1>Your Orders</h1>
        <p>Track shipments, invoices, and delivery status in one place.</p>
      </div>
    </section>

    <main class="page">
      <section class="card">
        <div id="ordersList" class="list">
          <div class="row">
            <div class="row-content">
              <strong>Loading orders...</strong>
              <div class="muted">Connect MetaMask to load your on-chain order history.</div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script>
      const ordersList = document.getElementById("ordersList");

      const statusClass = (status) => {
        if (status === "Delivered") return "status-delivered";
        if (status === "Failed") return "status-failed";
        return "status-pending";
      };

      const invoiceLabel = (invoice) => {
        if (!invoice) return "Not registered";
        const status = Number(invoice.status || 0);
        if (status === 1) return "Approved";
        if (status === 2) return "Rejected";
        return "Pending";
      };

      const renderOrders = (orders) => {
        if (!ordersList) return;
        if (!orders || !orders.length) {
          ordersList.innerHTML = `
            <div class="empty">No orders yet. Purchase a product to see it here.</div>
          `;
          return;
        }
        ordersList.innerHTML = orders.map((order) => {
          const date = order.createdAt ? new Date(order.createdAt).toLocaleString() : "Unknown";
          const reviewButton = order.statusLabel === "Delivered"
            ? `<a class="btn success" href="/review/${encodeURIComponent(order.trackingId)}">Leave Review</a>`
            : "";
          return `
            <div class="row">
              <div class="row-content">
                <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
                  <strong>${order.itemDescription || "Order"}</strong>
                  <span class="pill">${order.trackingId}</span>
                  <span class="status ${statusClass(order.statusLabel)}">${order.statusLabel}</span>
                </div>
                <div class="meta">
                  <div class="muted">Placed: ${date}</div>
                  <div class="muted">Seller: <span class="hash">${order.seller}</span></div>
                  <div class="muted">Amount: ${order.shipmentValue} ETH</div>
                  <div class="muted">Payment Tx: <span class="hash">${order.paymentTxHash ? order.paymentTxHash : "Pending"}</span></div>
                  <div class="muted">Invoice: ${invoiceLabel(order.invoice)}</div>
                </div>
              </div>
              <div class="order-actions">
                <a class="btn" href="/shipping/tracker?trackingId=${encodeURIComponent(order.trackingId)}">Track</a>
                <a class="btn ghost" href="/documents?trackingId=${encodeURIComponent(order.trackingId)}">Invoice</a>
                ${reviewButton}
              </div>
            </div>
          `;
        }).join("");
      };

      const loadOrders = async () => {
        if (!ordersList) return;
        try {
          const account = window.appWallet ? window.appWallet.getAccount() : "";
          const accountParam = account ? `?account=${encodeURIComponent(account)}` : "";
          const res = await fetch(`/api/orders/user${accountParam}`);
          const payload = await res.json();
          if (!res.ok || !payload.success) {
            ordersList.innerHTML = `
              <div class="empty">${payload.message || "Unable to load orders."}</div>
            `;
            return;
          }
          renderOrders(payload.orders);
        } catch (err) {
          ordersList.innerHTML = `
            <div class="empty">${err.message || "Unable to load orders."}</div>
          `;
        }
      };

      loadOrders();
      setInterval(loadOrders, 10000);
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden) {
          loadOrders();
        }
      });
    </script>
  </body>
</html>

