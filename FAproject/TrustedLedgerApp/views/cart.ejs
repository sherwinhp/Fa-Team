<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cart</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #111827;
        --muted: #6b7280;
        --panel: #ffffff;
        --soft: #f3f4f6;
        --border: #e5e7eb;
        --brand: #2563eb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        background: #f5f7fb;
        color: var(--ink);
      }

      .page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }

      .card {
        background: var(--panel);
        border-radius: 16px;
        border: 1px solid var(--border);
        padding: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
      }

      .item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
      }

      .item:last-child {
        border-bottom: none;
      }

      .thumb {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        object-fit: cover;
        background: var(--soft);
      }

      .actions {
        display: flex;
        gap: 10px;
        align-items: center;
      }

      .btn {
        border: none;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 600;
        cursor: pointer;
      }

      .btn-outline {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--ink);
      }

      .btn-primary {
        background: var(--brand);
        color: #fff;
      }

      .empty {
        border: 1px dashed var(--border);
        padding: 24px;
        border-radius: 14px;
        color: var(--muted);
        background: #fff;
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <div class="header">
        <h1 style="margin: 0;">Cart</h1>
        <a class="btn btn-outline" href="/products">Continue Shopping</a>
      </div>

      <section class="card">
        <% if (!cartItems || cartItems.length === 0) { %>
          <div class="empty">Your cart is empty.</div>
        <% } else { %>
          <% cartItems.forEach((item) => { %>
            <div class="item">
              <% const img = item.product.images && item.product.images.length ? item.product.images[0] : '/images/default-product.jpeg'; %>
              <img class="thumb" src="<%= img %>" alt="<%= item.product.productInfo.name %>">
              <div>
                <h3 style="margin: 0 0 6px;"><%= item.product.productInfo.name %></h3>
                <div style="color: var(--muted); font-size: 13px;">Qty: <%= item.quantity %></div>
                <div style="color: var(--brand); font-weight: 700;">$<%= item.product.productInfo.price %> ETHR</div>
              </div>
              <form class="actions" method="post" action="/cart/remove">
                <input type="hidden" name="productId" value="<%= item.product.id %>">
                <button class="btn btn-outline" type="submit">Remove</button>
                <a class="btn btn-primary" href="/product/<%= item.product.id %>">View</a>
              </form>
            </div>
          <% }) %>
          <form method="post" action="/cart/clear" style="margin-top: 16px;">
            <button class="btn btn-outline" type="submit">Clear Cart</button>
          </form>
        <% } %>
      </section>
    </main>
  </body>
</html>
