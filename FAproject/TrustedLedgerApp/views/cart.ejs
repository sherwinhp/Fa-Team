<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cart</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #111827;
        --muted: #6b7280;
        --panel: #ffffff;
        --soft: #f3f4f6;
        --border: #e5e7eb;
        --brand: #2563eb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        background: #f5f7fb;
        color: var(--ink);
      }

      .page {
        max-width: 1000px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 18px;
      }

      .card {
        background: var(--panel);
        border-radius: 16px;
        border: 1px solid var(--border);
        padding: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
      }

      .item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
      }

      .item:last-child {
        border-bottom: none;
      }

      .thumb {
        width: 80px;
        height: 80px;
        border-radius: 12px;
        object-fit: cover;
        background: var(--soft);
      }

      .actions {
        display: flex;
        gap: 10px;
        align-items: center;
      }

      .btn {
        border: none;
        border-radius: 10px;
        padding: 8px 12px;
        font-weight: 600;
        cursor: pointer;
      }

      .btn-outline {
        border: 1px solid var(--border);
        background: #fff;
        color: var(--ink);
      }

      .btn-primary {
        background: var(--brand);
        color: #fff;
      }

      .empty {
        border: 1px dashed var(--border);
        padding: 24px;
        border-radius: 14px;
        color: var(--muted);
        background: #fff;
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <div class="header">
        <h1 style="margin: 0;">Cart</h1>
        <a class="btn btn-outline" href="/products">Continue Shopping</a>
      </div>

      <section class="card">
        <div id="cartList" class="list">
          <div class="empty">Loading on-chain cart...</div>
        </div>
        <div id="cartSummary" style="margin-top: 16px;"></div>
      </section>
    </main>

    <script>
      (() => {
        const cartList = document.getElementById("cartList");
        const cartSummary = document.getElementById("cartSummary");

        const sendTransaction = async (txData) => {
          if (!window.ethereum) {
            alert("MetaMask not detected.");
            return null;
          }
          try {
            return await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [txData]
            });
          } catch (err) {
            alert("Transaction canceled or failed.");
            return null;
          }
        };

        const loadCart = async () => {
          if (!cartList) return;
          const account = window.appWallet ? window.appWallet.getAccount() : "";
          if (!account) {
            cartList.innerHTML = `<div class="empty">Connect MetaMask to load your on-chain cart.</div>`;
            if (cartSummary) {
              cartSummary.innerHTML = "";
            }
            return;
          }
          try {
            const res = await fetch(`/api/cart?account=${encodeURIComponent(account)}`);
            const payload = await res.json();
            if (!res.ok || !payload.success) {
              cartList.innerHTML = `<div class="empty">${payload.message || "Unable to load cart."}</div>`;
              return;
            }
            const items = payload.items || [];
            if (!items.length) {
              cartList.innerHTML = `<div class="empty">Your cart is empty.</div>`;
              if (cartSummary) {
                cartSummary.innerHTML = "";
              }
              return;
            }
            cartList.innerHTML = items.map((item) => {
              const img = item.product.images && item.product.images.length ? item.product.images[0] : "/images/default-product.jpeg";
              return `
                <div class="item">
                  <img class="thumb" src="${img}" alt="${item.product.productInfo.name}">
                  <div>
                    <h3 style="margin: 0 0 6px;">${item.product.productInfo.name}</h3>
                    <div style="color: var(--muted); font-size: 13px;">Qty: ${item.quantity}</div>
                    <div style="color: var(--brand); font-weight: 700;">$${item.product.productInfo.price} ETHR</div>
                  </div>
                  <div class="actions">
                    <button class="btn btn-outline" data-remove-id="${item.product.id}">Remove</button>
                    <a class="btn btn-primary" href="/product/${item.product.id}">View</a>
                  </div>
                </div>
              `;
            }).join("");

            if (cartSummary) {
              cartSummary.innerHTML = `
                <div style="display: flex; justify-content: space-between; align-items: center; gap: 12px;">
                  <div style="font-weight: 700;">Total: $${payload.totalEth} ETHR</div>
                  <a class="btn btn-primary" href="/checkout">Proceed to Checkout</a>
                </div>
                <button class="btn btn-outline" id="clearCartButton" type="button" style="margin-top: 12px;">Clear Cart</button>
              `;
            }
          } catch (err) {
            cartList.innerHTML = `<div class="empty">${err.message || "Unable to load cart."}</div>`;
          }
        };

        if (cartList) {
          cartList.addEventListener("click", async (event) => {
            const button = event.target.closest("[data-remove-id]");
            if (!button) return;
            const productId = button.getAttribute("data-remove-id");
            const account = window.appWallet ? window.appWallet.getAccount() : "";
            if (!account) {
              alert("Connect MetaMask to update the cart.");
              return;
            }
            const res = await fetch("/api/cart/tx/remove", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId, account })
            });
            const payload = await res.json();
            if (!res.ok || !payload.success) {
              alert(payload.message || "Unable to remove item.");
              return;
            }
            const txHash = await sendTransaction(payload.txData);
            if (txHash) {
              loadCart();
            }
          });
        }

        if (cartSummary) {
          cartSummary.addEventListener("click", async (event) => {
            if (event.target && event.target.id === "clearCartButton") {
              const account = window.appWallet ? window.appWallet.getAccount() : "";
              if (!account) {
                alert("Connect MetaMask to update the cart.");
                return;
              }
              const res = await fetch("/api/cart/tx/clear", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ account })
              });
              const payload = await res.json();
              if (!res.ok || !payload.success) {
                alert(payload.message || "Unable to clear cart.");
                return;
              }
              const txHash = await sendTransaction(payload.txData);
              if (txHash) {
                loadCart();
              }
            }
          });
        }

        loadCart();
        document.addEventListener("visibilitychange", () => {
          if (!document.hidden) {
            loadCart();
          }
        });
      })();
    </script>
  </body>
</html>
