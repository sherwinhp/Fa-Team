<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>All Products</title>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

    :root {
      --blue-600: #2563eb;
      --blue-700: #1d4ed8;
      --blue-50: #eff6ff;
      --green-600: #16a34a;
      --gray-50: #f9fafb;
      --gray-100: #f3f4f6;
      --gray-200: #e5e7eb;
      --gray-500: #6b7280;
      --gray-600: #4b5563;
      --gray-700: #374151;
      --gray-900: #111827;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
      color: var(--gray-900);
      background: radial-gradient(circle at top, #f4f6ff 0%, #ffffff 55%, #eef2ff 100%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 24px 20px 60px;
    }

    .header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      margin-bottom: 24px;
    }

    .header h1 {
      margin: 0;
      font-size: 28px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 20px;
    }

    .card {
      background: #fff;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid var(--gray-200);
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      display: flex;
      flex-direction: column;
      min-height: 100%;
    }

    .card img {
      width: 100%;
      height: 220px;
      object-fit: cover;
      object-position: center;
      display: block;
    }

    .card-body {
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }

    .badge {
      display: inline-flex;
      align-items: center;
      padding: 4px 10px;
      border-radius: 999px;
      font-size: 12px;
      background: var(--blue-50);
      color: var(--blue-700);
      font-weight: 600;
    }

    .price {
      font-size: 18px;
      font-weight: 700;
      color: var(--blue-600);
    }

    .stock {
      font-size: 12px;
      color: var(--green-600);
    }

    .btn {
      margin-top: auto;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 10px 12px;
      border-radius: 10px;
      background: var(--blue-600);
      color: #fff;
      font-weight: 600;
      border: none;
    }

    .btn.secondary {
      background: #fff;
      color: var(--gray-700);
      border: 1px solid var(--gray-200);
    }

    .btn.danger {
      background: #dc2626;
      color: #fff;
    }

    .empty {
      background: #fff;
      border: 1px dashed var(--gray-200);
      padding: 24px;
      border-radius: 16px;
      color: var(--gray-600);
    }
  </style>
</head>
<body>
  <%- include('partials/navbar', { acct }) %>

  <div class="page">
    <div class="header">
      <h1>All Products</h1>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <% if (isLoggedIn && (userRole === 'admin' || userRole === 'super_admin')) { %>
          <a class="btn" href="/addproduct">Add Product</a>
        <% } %>
        <a class="btn secondary" href="/">Back to Marketplace</a>
      </div>
    </div>

    <% if (status) { %>
      <p style="color: var(--gray-600);">Loading blockchain data...</p>
    <% } %>

    <% if (!products || products.length === 0) { %>
      <div class="empty">No products available yet.</div>
    <% } else { %>
      <div class="grid">
        <% products.forEach(item => { %>
          <div class="card">
            <% const img = item.images && item.images.length ? item.images[0] : '/images/default-product.jpeg'; %>
            <img src="<%= img %>" alt="<%= item.productInfo.name %>">

            <div class="card-body">
              <span class="badge"><%= item.productInfo.category || "Verified" %></span>
              <h3 style="margin: 0;"><%= item.productInfo.name %></h3>
              <p style="margin: 0; color: var(--gray-600);"><%= item.productInfo.description %></p>
              <div class="price">$<%= item.productInfo.price %> ETHR</div>
              <div class="stock"><%= item.status %> ? <%= item.stock %> in stock</div>
              <a class="btn" href="/product/<%= item.id %>">View Details</a>
              <% if (isLoggedIn && (userRole === 'admin' || userRole === 'super_admin')) { %>
                <div style="display:flex;gap:8px;flex-wrap:wrap;margin-top:8px;">
                  <a class="btn secondary" href="/admin/products/<%= item.id %>/edit">Edit</a>
                  <button class="btn danger delete-product" type="button" data-product-id="<%= item.id %>">Delete</button>
                </div>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <% if (isLoggedIn && (userRole === 'admin' || userRole === 'super_admin')) { %>
    <script>
      const deleteButtons = Array.from(document.querySelectorAll(".delete-product"));
      const allowedChains = ["0x539", "0x1691"];
      let contractAdmin = "";

      const loadContractAdmin = async () => {
        try {
          const res = await fetch("/api/contracts/admin");
          const payload = await res.json();
          if (res.ok && payload.success && payload.admin) {
            contractAdmin = payload.admin;
          }
        } catch (err) {
          contractAdmin = "";
        }
      };

      loadContractAdmin();

      const getConnectedAccount = async () => {
        if (window.appWallet && window.appWallet.isConnected()) {
          return window.appWallet.getAccount();
        }
        if (window.appWallet) {
          const result = await window.appWallet.connect();
          return result && result.account ? result.account : "";
        }
        if (window.ethereum) {
          const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
          return accounts && accounts[0] ? accounts[0] : "";
        }
        return "";
      };

      const ensureGanacheChain = async () => {
        if (!window.ethereum) {
          return false;
        }
        const chainId = await window.ethereum.request({ method: "eth_chainId" });
        return chainId && allowedChains.includes(String(chainId).toLowerCase());
      };

      deleteButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          const productId = button.dataset.productId;
          if (!productId) {
            return;
          }
          if (!confirm("Remove this product from the on-chain catalog?")) {
            return;
          }

          const account = await getConnectedAccount();
          if (!account) {
            alert("Connect MetaMask to delete products.");
            return;
          }
          if (contractAdmin && account.toLowerCase() !== contractAdmin.toLowerCase()) {
            alert(`Connect the contract owner (${contractAdmin}) before deleting products.`);
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }

          try {
            const response = await fetch("/api/products/tx/delete", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId, account })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to prepare delete transaction.");
              return;
            }
            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });
            window.location.reload();
          } catch (error) {
            alert(error.message || "Unable to delete product.");
          }
        });
      });
    </script>
  <% } %>
</body>
</html>
