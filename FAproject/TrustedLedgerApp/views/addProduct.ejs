<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Add Product | Blockchain Marketplace</title>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

    :root {
      --blue-600: #2563eb;
      --blue-700: #1d4ed8;
      --blue-50: #eff6ff;
      --gray-50: #f9fafb;
      --gray-100: #f3f4f6;
      --gray-200: #e5e7eb;
      --gray-500: #6b7280;
      --gray-600: #4b5563;
      --gray-700: #374151;
      --gray-900: #111827;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
      color: var(--gray-900);
      background: radial-gradient(circle at top, #f4f6ff 0%, #ffffff 55%, #eef2ff 100%);
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    .page {
      max-width: 900px;
      margin: 0 auto;
      padding: 32px 20px 60px;
    }

    .header {
      background: linear-gradient(135deg, #1e40af 0%, #2563eb 55%, #3b82f6 100%);
      border-radius: 24px;
      padding: 36px 32px;
      color: #fff;
      margin-bottom: 28px;
    }

    .header h1 {
      font-family: "Fraunces", Georgia, serif;
      margin: 0 0 12px;
      font-size: clamp(2rem, 4vw, 2.6rem);
    }

    .header p {
      margin: 0;
      color: rgba(255, 255, 255, 0.85);
    }

    .card {
      background: #fff;
      border-radius: 18px;
      border: 1px solid var(--gray-200);
      box-shadow: 0 16px 40px rgba(15, 23, 42, 0.08);
      padding: 24px;
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    label {
      display: block;
      font-size: 13px;
      font-weight: 600;
      color: var(--gray-600);
      margin-bottom: 8px;
    }

    input,
    textarea {
      width: 100%;
      padding: 12px 14px;
      border-radius: 10px;
      border: 1px solid var(--gray-200);
      font-family: inherit;
      font-size: 14px;
      background: var(--gray-50);
      color: var(--gray-900);
    }

    textarea {
      min-height: 120px;
      resize: vertical;
    }

    .full {
      grid-column: 1 / -1;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 12px 18px;
      border-radius: 999px;
      border: none;
      background: var(--blue-600);
      color: #fff;
      font-weight: 600;
      cursor: pointer;
    }

    .hint {
      font-size: 12px;
      color: var(--gray-500);
      margin-top: 6px;
    }

    .error {
      background: #fee2e2;
      border: 1px solid #fecaca;
      color: #b91c1c;
      padding: 12px 14px;
      border-radius: 10px;
      margin-bottom: 16px;
      font-size: 14px;
    }
  </style>
</head>
<body>
  <%- include('partials/navbar', { acct }) %>

  <div class="page">
    <section class="header">
      <h1>Add a Verified Product</h1>
      <p>Create a new listing and anchor it to the blockchain marketplace.</p>
    </section>

    <div class="card">
      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>
      <div class="error" id="onchainError" style="display: none;"></div>

      <form id="addProductForm" action="/addproduct" method="POST">
        <div class="form-grid">
          <div>
            <label for="name">Product Name *</label>
            <input id="name" name="name" required value="<%= formData.name || '' %>" />
          </div>
          <div>
            <label for="price">Price (ETHR) *</label>
            <input id="price" name="price" type="number" step="0.01" required value="<%= formData.price || '' %>" />
          </div>
          <div>
            <label for="category">Category</label>
            <input id="category" name="category" value="<%= formData.category || '' %>" />
          </div>
          <div>
            <label for="stock">Stock</label>
            <input id="stock" name="stock" type="number" min="0" value="<%= formData.stock || '' %>" />
          </div>
          <div class="full">
            <label for="description">Short Description *</label>
            <textarea id="description" name="description" required><%= formData.description || '' %></textarea>
          </div>
          <div class="full">
            <label for="fullDescription">Full Description</label>
            <textarea id="fullDescription" name="fullDescription"><%= formData.fullDescription || '' %></textarea>
          </div>
          <div class="full">
            <label for="features">Key Features (one per line)</label>
            <textarea id="features" name="features"><%= formData.features || '' %></textarea>
            <div class="hint">Example: Active Noise Cancellation</div>
          </div>
          <div class="full">
            <label for="specifications">Specifications (Label: Value, one per line)</label>
            <textarea id="specifications" name="specifications"><%= formData.specifications || '' %></textarea>
            <div class="hint">Example: Battery Life: 30 hours</div>
          </div>
          <div class="full">
            <label for="imageUrls">Image URLs (comma or newline separated)</label>
            <textarea id="imageUrls" name="imageUrls"><%= formData.imageUrls || '' %></textarea>
          </div>
          <div>
            <label for="sellerName">Seller Name</label>
            <input id="sellerName" name="sellerName" value="<%= formData.sellerName || '' %>" />
          </div>
        </div>

        <div style="margin-top: 20px;">
          <button class="btn" type="submit">Add Product</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    (() => {
      const form = document.getElementById("addProductForm");
      const errorBox = document.getElementById("onchainError");

      const showError = (message) => {
        if (!errorBox) {
          return;
        }
        errorBox.textContent = message;
        errorBox.style.display = "block";
      };

      const getPrimaryImage = (value) => {
        if (!value) {
          return "";
        }
        const parts = value
          .split(/\r?\n|,/)
          .map((item) => item.trim())
          .filter(Boolean);
        return parts[0] || "";
      };

      const ensureConnected = async () => {
        if (window.appWallet && window.appWallet.isConnected()) {
          return window.appWallet.getAccount();
        }
        if (window.appWallet) {
          const result = await window.appWallet.connect();
          return result && result.account ? result.account : "";
        }
        if (window.ethereum) {
          const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
          return accounts && accounts[0] ? accounts[0] : "";
        }
        return "";
      };

      if (form) {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (errorBox) {
            errorBox.style.display = "none";
          }

          try {
            const account = await ensureConnected();
            if (!account) {
              showError("Connect MetaMask to add products on-chain.");
              return;
            }

            const formData = new FormData(form);
            const name = String(formData.get("name") || "").trim();
            const description = String(formData.get("description") || "").trim();
            const price = String(formData.get("price") || "").trim();
            const category = String(formData.get("category") || "").trim();
            const imageUrl = getPrimaryImage(String(formData.get("imageUrls") || ""));
            const sellerName = String(formData.get("sellerName") || "").trim();
            const stock = String(formData.get("stock") || "").trim();
            const fullDescription = String(formData.get("fullDescription") || "").trim();
            const features = String(formData.get("features") || "");
            const specifications = String(formData.get("specifications") || "");

            if (!name || !description || !price) {
              showError("Product name, description, and price are required.");
              return;
            }

            const response = await fetch("/api/products/tx/create", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                name,
                description,
                price,
                category,
                imageUrl,
                sellerName,
                stock,
                fullDescription,
                features,
                specifications,
                account
              })
            });

            const payload = await response.json();
            if (!response.ok || !payload.success) {
              showError(payload.message || "Unable to prepare on-chain transaction.");
              return;
            }

            if (!window.ethereum) {
              showError("MetaMask not available to sign the transaction.");
              return;
            }

            await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [payload.txData]
            });

            window.location.href = "/admin";
          } catch (err) {
            showError(err.message || "Unable to add product on-chain.");
          }
        });
      }
    })();
  </script>
</body>
</html>
