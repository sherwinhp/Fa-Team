<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Checkout</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #111827;
        --muted: #6b7280;
        --panel: #ffffff;
        --soft: #f3f4f6;
        --border: #e5e7eb;
        --brand: #2563eb;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        background: #f5f7fb;
        color: var(--ink);
      }

      .page {
        max-width: 960px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .card {
        background: var(--panel);
        border-radius: 16px;
        border: 1px solid var(--border);
        padding: 18px;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.08);
      }

      .item {
        display: grid;
        grid-template-columns: auto 1fr auto;
        gap: 16px;
        align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--border);
      }

      .item:last-child {
        border-bottom: none;
      }

      .thumb {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        object-fit: cover;
        background: var(--soft);
      }

      .btn {
        border: none;
        border-radius: 10px;
        padding: 10px 14px;
        font-weight: 600;
        cursor: pointer;
      }

      .btn-primary {
        background: var(--brand);
        color: #fff;
      }

      .muted {
        color: var(--muted);
        font-size: 13px;
      }

      .total {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-weight: 700;
        margin-top: 16px;
      }

      .notice {
        margin-top: 12px;
        font-size: 12px;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="page">
      <h1 style="margin: 0 0 16px;">Checkout</h1>
      <section class="card">
        <div id="checkoutList" class="list">
          <div class="muted">Loading cart...</div>
        </div>
        <div id="checkoutSummary"></div>
      </section>
    </main>

    <script>
      (() => {
        const checkoutList = document.getElementById("checkoutList");
        const checkoutSummary = document.getElementById("checkoutSummary");
        const recipientName = "<%= userEmail || 'Marketplace Customer' %>";
        const providerUrl = "<%= ganacheProviderUrl || '' %>";
        const allowedChains = ["0x539", "0x1691"];

        const sendTransaction = async (txData) => {
          if (!window.ethereum) {
            alert("MetaMask not detected.");
            return null;
          }
          try {
            return await window.ethereum.request({
              method: "eth_sendTransaction",
              params: [txData]
            });
          } catch (err) {
            alert("Transaction canceled or failed.");
            return null;
          }
        };

        const ensureConnected = async () => {
          if (window.appWallet && window.appWallet.isConnected()) {
            return window.appWallet.getAccount();
          }
          if (window.appWallet) {
            const result = await window.appWallet.connect();
            return result && result.account ? result.account : "";
          }
          if (window.ethereum) {
            const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
            return accounts && accounts[0] ? accounts[0] : "";
          }
          return "";
        };

        const ensureBackendWeb3 = async (account) => {
          if (!account) {
            return false;
          }
          let contractAddress = "";
          if (window.ethereum) {
            try {
              const [chainId, contractResponse] = await Promise.all([
                window.ethereum.request({ method: "eth_chainId" }),
                fetch("/build/ShippingTrackerContract.json")
              ]);
              if (contractResponse.ok) {
                const contractInfo = await contractResponse.json();
                const chainDecimal = Number.parseInt(chainId, 16);
                const networks = contractInfo && contractInfo.networks ? contractInfo.networks : {};
                const networkInfo = networks[chainDecimal] || networks[String(chainDecimal)];
                contractAddress = networkInfo && networkInfo.address ? networkInfo.address : "";
              }
            } catch (err) {
              contractAddress = "";
            }
          }

          try {
            const response = await fetch("/web3Connect", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                contractAddress: contractAddress || "",
                acct: account,
                providerUrl: providerUrl || undefined
              })
            });
            return response.ok;
          } catch (err) {
            return false;
          }
        };

        const renderCart = (items, totalEth) => {
          if (!checkoutList || !checkoutSummary) {
            return;
          }
          if (!items || !items.length) {
            checkoutList.innerHTML = `<div class="muted">Your cart is empty.</div>`;
            checkoutSummary.innerHTML = "";
            return;
          }
          checkoutList.innerHTML = items.map((item) => {
            const img = item.product.images && item.product.images.length ? item.product.images[0] : "/images/default-product.jpeg";
            return `
              <div class="item">
                <img class="thumb" src="${img}" alt="${item.product.productInfo.name}">
                <div>
                  <strong>${item.product.productInfo.name}</strong>
                  <div class="muted">Qty: ${item.quantity}</div>
                </div>
                <div style="font-weight: 700;">$${item.product.productInfo.price} ETHR</div>
              </div>
            `;
          }).join("");
          checkoutSummary.innerHTML = `
            <div class="total">
              <span>Total</span>
              <span>$${totalEth} ETHR</span>
            </div>
            <button class="btn btn-primary" id="checkoutPayButton" type="button" style="margin-top: 16px;">
              Pay with MetaMask
            </button>
            <div class="notice">
              Payment is held in escrow and released once delivery is confirmed.
            </div>
          `;
        };

        const loadCart = async () => {
          if (!checkoutList) {
            return null;
          }
          try {
            const res = await fetch("/api/cart");
            const payload = await res.json();
            if (!res.ok || !payload.success) {
              checkoutList.innerHTML = `<div class="muted">${payload.message || "Unable to load cart."}</div>`;
              if (checkoutSummary) {
                checkoutSummary.innerHTML = "";
              }
              return null;
            }
            renderCart(payload.items || [], payload.totalEth || "0.0000");
            return payload;
          } catch (err) {
            checkoutList.innerHTML = `<div class="muted">${err.message || "Unable to load cart."}</div>`;
            if (checkoutSummary) {
              checkoutSummary.innerHTML = "";
            }
            return null;
          }
        };

        const handleCheckout = async () => {
          const payButton = document.getElementById("checkoutPayButton");
          if (!payButton) {
            return;
          }
          if (payButton.dataset.processing === "true") {
            return;
          }
          payButton.dataset.processing = "true";
          payButton.disabled = true;
          const originalLabel = payButton.textContent;
          payButton.textContent = "Processing...";

          if (window.ethereum) {
            const chainId = await window.ethereum.request({ method: "eth_chainId" });
            if (chainId && !allowedChains.includes(String(chainId).toLowerCase())) {
              alert("Wrong network. Please switch MetaMask to Ganache (Chain ID 1337).");
              payButton.dataset.processing = "false";
              payButton.disabled = false;
              payButton.textContent = originalLabel;
              return;
            }
          }

          const account = await ensureConnected();
          if (!account) {
            payButton.dataset.processing = "false";
            payButton.disabled = false;
            payButton.textContent = originalLabel;
            return;
          }
          const backendReady = await ensureBackendWeb3(account);
          if (!backendReady) {
            alert("Web3 not connected. Make sure MetaMask is on the Ganache network and try again.");
            payButton.dataset.processing = "false";
            payButton.disabled = false;
            payButton.textContent = originalLabel;
            return;
          }

          const trackingId = `TRK-${Date.now()}`;
          const cartPayload = await loadCart();
          if (!cartPayload || !cartPayload.items || !cartPayload.items.length) {
            alert("Cart is empty.");
            payButton.dataset.processing = "false";
            payButton.disabled = false;
            payButton.textContent = originalLabel;
            return;
          }
          const payload = {
            trackingId,
            recipientName,
            recipientAddress: "Address on file",
            itemDescription: "Marketplace order",
            shipmentValue: "0.0000",
            useCartTotal: true,
            account,
            productIds: cartPayload.items.map((item) => item.product.id),
            quantities: cartPayload.items.map((item) => item.quantity),
            productNames: cartPayload.items.map((item) => item.product.productInfo.name || ""),
            productImages: cartPayload.items.map((item) => {
              const images = item.product.images || [];
              return images.length ? images[0] : "";
            })
          };

          const res = await fetch("/createShipment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (!data || !data.txData) {
            alert(data && data.message ? data.message : "Unable to create shipment.");
            payButton.dataset.processing = "false";
            payButton.disabled = false;
            payButton.textContent = originalLabel;
            return;
          }

          const txHash = await sendTransaction(data.txData);
          if (!txHash) {
            payButton.dataset.processing = "false";
            payButton.disabled = false;
            payButton.textContent = originalLabel;
            return;
          }

            try {
              const recordResponse = await fetch("/api/orders/tx/payment", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  trackingId,
                  paymentTxHash: txHash,
                  account
                })
              });
              const recordPayload = await recordResponse.json();
              if (recordResponse.ok && recordPayload.success) {
                await sendTransaction(recordPayload.txData);
              }
              await fetch("/api/cart/clear", {
                method: "POST",
                headers: { "Content-Type": "application/json" }
              });
              loadCart();
            } catch (err) {
              // ignore storage errors
            }

          window.location.href = `/shipping/tracker?trackingId=${encodeURIComponent(trackingId)}`;
        };

        document.addEventListener("click", (event) => {
          if (event.target && event.target.id === "checkoutPayButton") {
            handleCheckout();
          }
        });

        loadCart();
        document.addEventListener("visibilitychange", () => {
          if (!document.hidden) {
            loadCart();
          }
        });
      })();
    </script>
  </body>
</html>
