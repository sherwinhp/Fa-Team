<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Documents | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #0f172a;
        --muted: #64748b;
        --surface: #ffffff;
        --panel: #f1f5f9;
        --brand: #2563eb;
        --shadow: 0 18px 45px rgba(15, 23, 42, 0.12);
        --radius-lg: 20px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        color: var(--ink);
        background: radial-gradient(circle at top, #eef2ff 0%, #ffffff 55%, #f3f7ff 100%);
        min-height: 100vh;
      }

      .hero {
        background: linear-gradient(120deg, #1e40af 0%, #2563eb 60%, #38bdf8 100%);
        color: #fff;
        padding: 40px 24px 46px;
        position: relative;
        overflow: hidden;
      }

      .hero::after {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(255, 255, 255, 0.25), transparent 70%);
        top: -160px;
        right: -120px;
      }

      .hero-inner {
        max-width: 1100px;
        margin: 0 auto;
        position: relative;
        z-index: 1;
        padding: 0 12px;
      }

      .hero h1 {
        margin: 0 0 8px;
        font-family: "Fraunces", Georgia, serif;
        font-size: clamp(1.8rem, 3vw, 2.4rem);
      }

      .hero p {
        margin: 0;
        font-size: 14px;
        color: rgba(255, 255, 255, 0.85);
      }

      .page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 28px 24px 70px;
      }

      .card {
        background: var(--surface);
        border-radius: var(--radius-lg);
        padding: 22px;
        box-shadow: var(--shadow);
        border: 1px solid #e2e8f0;
      }

      .card h2 {
        margin: 0 0 8px;
        font-size: 18px;
      }

      .card p {
        margin: 0;
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 18px;
        margin-top: 18px;
      }

      .field {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 12px;
      }

      label {
        font-size: 13px;
        font-weight: 600;
        color: var(--muted);
      }

      input, select, textarea {
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        padding: 10px 12px;
        font-size: 14px;
        font-family: inherit;
      }

      .btn {
        margin-top: 12px;
        border: none;
        border-radius: 999px;
        padding: 10px 16px;
        background: var(--brand);
        color: #fff;
        font-weight: 600;
        cursor: pointer;
      }

      .btn-outline {
        border: 1px solid #cbd5f5;
        background: #fff;
        color: var(--brand);
        padding: 10px 16px;
        border-radius: 999px;
        font-weight: 600;
        cursor: pointer;
      }

      .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
      }

      .status-approved {
        background: #dcfce7;
        color: #16a34a;
      }

      .status-rejected {
        background: #fee2e2;
        color: #dc2626;
      }

      .status-pending {
        background: #fef9c3;
        color: #ca8a04;
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <section class="hero">
      <div class="hero-inner">
        <h1>Documents</h1>
        <p>Access your blockchain verification files and shipment records.</p>
      </div>
    </section>

    <main class="page">
      <div class="grid">
        <section class="card">
          <h2>Invoice Generator</h2>
          <p>Generate a PDF invoice and register its hash on-chain.</p>
          <div class="field">
            <label for="invoiceTrackingId">Tracking ID</label>
            <input id="invoiceTrackingId" placeholder="TRK-..." />
          </div>
          <div class="field">
            <label>Invoice status</label>
            <div id="invoiceStatus" class="status-pill status-pending">Not registered</div>
          </div>
          <button class="btn" id="downloadInvoiceBtn" type="button">Download PDF & Register</button>
        </section>

        <section class="card">
          <h2>Document Notarization</h2>
          <p>Upload your invoice PDF for authenticity verification.</p>
          <div class="field">
            <label for="verifyTrackingId">Tracking ID</label>
            <input id="verifyTrackingId" placeholder="TRK-..." />
          </div>
          <div class="field">
            <label for="invoiceFile">Invoice PDF</label>
            <input id="invoiceFile" type="file" accept="application/pdf" />
          </div>
          <button class="btn-outline" id="verifyInvoiceBtn" type="button">Verify Invoice</button>
          <div class="field">
            <label>Verification result</label>
            <div id="verifyResult" class="status-pill status-pending">Waiting</div>
          </div>
          <p style="font-size:13px;color:#475569;margin-top:10px;">
            Verification uses server-side hash comparison and does <strong>not</strong> cost gas.
            Registration and attestation still require admin approval and MetaMask.
          </p>
          <% if (userRole === 'admin' || userRole === 'super_admin') { %>
            <div class="field" style="display:flex;gap:10px;flex-direction:row;">
              <button class="btn" id="approveInvoiceBtn" type="button">Approve</button>
              <button class="btn-outline" id="rejectInvoiceBtn" type="button">Reject</button>
            </div>
          <% } %>
        </section>
      </div>
    </main>

    <script>
      const allowedChains = ["0x539", "0x1691"];
      const invoiceTrackingId = document.getElementById("invoiceTrackingId");
      const invoiceStatus = document.getElementById("invoiceStatus");
      const downloadInvoiceBtn = document.getElementById("downloadInvoiceBtn");
      const verifyTrackingId = document.getElementById("verifyTrackingId");
      const invoiceFile = document.getElementById("invoiceFile");
      const verifyInvoiceBtn = document.getElementById("verifyInvoiceBtn");
      const verifyResult = document.getElementById("verifyResult");
      const approveInvoiceBtn = document.getElementById("approveInvoiceBtn");
      const rejectInvoiceBtn = document.getElementById("rejectInvoiceBtn");
      const urlParams = new URLSearchParams(window.location.search);
      const prefillTrackingId = urlParams.get("trackingId");

      if (prefillTrackingId) {
        if (invoiceTrackingId) {
          invoiceTrackingId.value = prefillTrackingId;
        }
        if (verifyTrackingId) {
          verifyTrackingId.value = prefillTrackingId;
        }
      }

      const ensureGanacheChain = async () => {
        if (!window.ethereum) {
          return false;
        }
        const chainId = await window.ethereum.request({ method: "eth_chainId" });
        return chainId && allowedChains.includes(String(chainId).toLowerCase());
      };

      const hashBufferToHex = (buffer) => {
        return Array.from(new Uint8Array(buffer)).map(b => b.toString(16).padStart(2, "0")).join("");
      };

      const formatEthFromWei = (weiValue) => {
        try {
          const wei = BigInt(String(weiValue || "0"));
          const divisor = 10n ** 18n;
          const whole = wei / divisor;
          const fraction = (wei % divisor).toString().padStart(18, "0").slice(0, 4);
          return `${whole.toString()}.${fraction}`;
        } catch (error) {
          return "0.0000";
        }
      };

      const formatTimestamp = (value) => {
        const num = Number(value);
        if (!Number.isFinite(num) || num <= 0) return null;
        const ms = num > 10_000_000_000 ? num : num * 1000;
        return new Date(ms).toLocaleString();
      };

      const sha256 = async (data) => {
        const hashBuffer = await crypto.subtle.digest("SHA-256", data);
        return hashBufferToHex(hashBuffer);
      };

      const escapePdfText = (text) => String(text || "").replace(/[()\\\\]/g, "\\\\$&");
      const toAsciiSafe = (text) => String(text || "")
        .replace(/[\r\n\t]+/g, " ")
        .replace(/[^\x00-\x7F]/g, "?");
      const clampText = (text, maxLen) => {
        const safe = String(text || "");
        if (safe.length <= maxLen) return safe;
        return safe.slice(0, Math.max(0, maxLen - 3)) + "...";
      };
      const shortenMiddle = (value, head = 10, tail = 6) => {
        const text = String(value || "");
        if (text.length <= head + tail + 3) return text;
        return `${text.slice(0, head)}...${text.slice(-tail)}`;
      };

      const buildPdf = (lines) => {
        const contentLines = lines.map((line, index) => {
          const y = 760 - index * 18;
          const safeLine = escapePdfText(toAsciiSafe(line));
          return `1 0 0 1 50 ${y} Tm (${safeLine}) Tj`;
        }).join("\n");

        const stream = `BT /F1 12 Tf\n${contentLines}\nET`;
        const objects = [
          "1 0 obj<< /Type /Catalog /Pages 2 0 R>>endobj",
          "2 0 obj<< /Type /Pages /Kids [3 0 R] /Count 1>>endobj",
          "3 0 obj<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources<< /Font<< /F1 4 0 R>> >> /Contents 5 0 R>>endobj",
          "4 0 obj<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica>>endobj",
          `5 0 obj<< /Length ${stream.length}>>stream\n${stream}\nendstream endobj`
        ];

        const encoder = new TextEncoder();
        const header = "%PDF-1.3\n";
        let body = header;
        let offset = encoder.encode(body).length;
        const xref = ["xref", `0 ${objects.length + 1}`, "0000000000 65535 f "];

        objects.forEach((obj) => {
          xref.push(String(offset).padStart(10, "0") + " 00000 n ");
          body += obj + "\n";
          offset = encoder.encode(body).length;
        });

        const xrefOffset = encoder.encode(body).length;
        const trailer = `trailer<< /Size ${objects.length + 1} /Root 1 0 R>>\nstartxref\n${xrefOffset}\n%%EOF`;
        return encoder.encode(body + xref.join("\n") + "\n" + trailer);
      };

      const getOrderDetails = async (trackingId) => {
        try {
          const res = await fetch(`/api/orders/${encodeURIComponent(trackingId)}`);
          const payload = await res.json();
          if (!res.ok || !payload.success) {
            return {
              success: false,
              message: payload && payload.message ? payload.message : `Unable to load order (${res.status})`
            };
          }
          return payload;
        } catch (err) {
          return { success: false, message: err && err.message ? err.message : "Unable to load order" };
        }
      };

      const fetchShipment = async (trackingId) => {
        const res = await fetch(`/api/shipping/${encodeURIComponent(trackingId)}`);
        if (!res.ok) return null;
        return res.json();
      };

      const fetchInvoice = async (trackingId) => {
        try {
          const res = await fetch(`/api/invoices/${encodeURIComponent(trackingId)}`);
          const payload = await res.json();
          if (!res.ok || !payload.success) return null;
          return payload.invoice || null;
        } catch (err) {
          return null;
        }
      };

      const setStatus = (el, status) => {
        el.className = "status-pill " + (status === "Approved"
          ? "status-approved"
          : status === "Rejected"
            ? "status-rejected"
            : "status-pending");
        el.textContent = status;
      };

      const sendTx = async (txData) => {
        if (!window.ethereum) {
          alert("MetaMask not detected.");
          return null;
        }
        return window.ethereum.request({
          method: "eth_sendTransaction",
          params: [txData]
        });
      };

      if (downloadInvoiceBtn) {
        downloadInvoiceBtn.addEventListener("click", async () => {
          const trackingId = invoiceTrackingId.value.trim();
          if (!trackingId) {
            alert("Tracking ID required.");
            return;
          }
          const onChain = await ensureGanacheChain();
          if (!onChain) {
            alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
            return;
          }
          if (!window.ethereum) {
            alert("MetaMask not detected.");
            return;
          }
          const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
          const account = accounts && accounts[0] ? accounts[0] : "";
          if (!account) {
            alert("Connect MetaMask to continue.");
            return;
          }

          const shipment = await fetchShipment(trackingId);
          const orderDetails = await getOrderDetails(trackingId);
          if (!orderDetails || !orderDetails.success) {
            alert(orderDetails && orderDetails.message ? orderDetails.message : "Order details not found.");
            return;
          }
          const existingInvoice = await fetchInvoice(trackingId);
          const hasInvoice = existingInvoice
            && existingInvoice.buyer
            && existingInvoice.buyer !== "0x0000000000000000000000000000000000000000";
          const shipmentData = orderDetails.shipment || null;
          const items = orderDetails.orderItems || [];
          const fallbackBuyer = shipment && shipment.buyer ? shipment.buyer : "Unknown";
          const buyerAddress = shipmentData && shipmentData.buyer ? shipmentData.buyer : fallbackBuyer;
          const sellerOnChain = shipmentData && shipmentData.seller ? shipmentData.seller : (shipment && shipment.seller ? shipment.seller : "Unknown");
          const recipientName = shipmentData && shipmentData.recipientName ? shipmentData.recipientName : "Marketplace Customer";
          const recipientAddress = shipmentData && shipmentData.recipientAddress ? shipmentData.recipientAddress : "Address on file";
          const itemDescription = shipmentData && shipmentData.itemDescription ? shipmentData.itemDescription : "On-chain order items";
          const createdAt = shipmentData ? formatTimestamp(shipmentData.createdAt) : null;
          const buyerEmail = "<%= userEmail || '' %>";
          const paymentTxHash = orderDetails.paymentTxHash || "";
          const qrPayload = `${window.location.origin}/shipping/tracker?trackingId=${encodeURIComponent(trackingId)}`;
          const lineItems = items.map((item, index) => {
            const qty = Number(item.quantity || 0);
            const unitPriceEth = formatEthFromWei(item.priceWei || "0");
            let lineTotalEth = "0.0000";
            try {
              const lineTotalWei = BigInt(String(item.priceWei || "0")) * BigInt(qty || 0);
              lineTotalEth = formatEthFromWei(lineTotalWei);
            } catch (error) {
              lineTotalEth = "0.0000";
            }
            return {
              index: index + 1,
              productId: item.productId || "N/A",
              name: item.name || `Product ${index + 1}`,
              quantity: qty || 1,
              unitPriceEth,
              lineTotalEth,
              imageUrl: item.imageUrl || ""
            };
          });

          let orderTotalWei = orderDetails.orderTotalWei || "0";
          if (orderTotalWei === "0" && lineItems.length) {
            try {
              const computedWei = lineItems.reduce((sum, item) => {
                const qty = Number(item.quantity || 0);
                const unitWei = BigInt(String(items[item.index - 1]?.priceWei || "0"));
                return sum + unitWei * BigInt(qty || 0);
              }, 0n);
              orderTotalWei = computedWei.toString();
            } catch (error) {
              orderTotalWei = "0";
            }
          }

          const orderTotalEth = formatEthFromWei(orderTotalWei);
          const shipmentValueEth = shipmentData && shipmentData.shipmentValue
            ? formatEthFromWei(shipmentData.shipmentValue)
            : (shipment && shipment.shipmentValue ? String(shipment.shipmentValue) : "0.0000");
          const lines = [
            "TrustedLedger Invoice",
            "========================================",
            `Invoice #: INV-${trackingId}-${Date.now()}`,
            `Tracking ID: ${trackingId}`,
            `Issued: ${new Date().toLocaleString()}`,
            "",
            "Bill To",
            `Wallet: ${shortenMiddle(buyerAddress || "Unknown")}`,
            `Email: ${buyerEmail || "Unknown"}`,
            `Recipient: ${recipientName}`,
            `Delivery: ${recipientAddress}`,
            "",
            "Seller",
            `Wallet: ${shortenMiddle(sellerOnChain || "Unknown")}`,
            "",
            "Order Summary",
            `Description: ${clampText(itemDescription, 60)}`,
            `Order Total (ETH): ${orderTotalEth}`,
            `Shipment Value (ETH): ${shipmentValueEth}`,
            `Payment Tx: ${paymentTxHash ? shortenMiddle(paymentTxHash, 12, 8) : "Pending"}`,
            "----------------------------------------",
            "Items"
          ];
          if (lineItems.length) {
            lineItems.forEach((item) => {
              const name = clampText(item.name, 44);
              lines.push(`${item.index}. ${name}`);
              lines.push(`   Qty: ${item.quantity} @ ${item.unitPriceEth} ETH`);
              lines.push(`   Line Total: ${item.lineTotalEth} ETH`);
              if (item.productId && item.productId !== "N/A") {
                lines.push(`   Product ID: ${shortenMiddle(item.productId, 14, 8)}`);
              }
            });
          } else {
            lines.push("No line items found for this order.");
          }
          lines.push("", "Thank you for shopping with TrustedLedger.");

          const pdfBytes = buildPdf(lines);
          const invoiceHash = await sha256(pdfBytes);

          if (!hasInvoice) {
            const txRes = await fetch("/api/invoices/tx/register", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ trackingId, invoiceHash, account })
            });
            const txPayload = await txRes.json();
            if (!txRes.ok || !txPayload.success) {
              const message = String(txPayload.message || "Unable to register invoice.");
              if (message.toLowerCase().includes("invoice exists")) {
                alert("Invoice already registered for this tracking ID. Downloading a copy only.");
              } else {
                alert(message);
                return;
              }
            } else {
              await sendTx(txPayload.txData);
              setStatus(invoiceStatus, "Pending");
            }
          } else {
            const statusLabel = Number(existingInvoice.status || 0) === 1
              ? "Approved"
              : Number(existingInvoice.status || 0) === 2
                ? "Rejected"
                : "Pending";
            setStatus(invoiceStatus, statusLabel);
            alert("Invoice already registered for this tracking ID. Downloading a copy only.");
          }

          const blob = new Blob([pdfBytes], { type: "application/pdf" });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.download = `invoice-${trackingId}.pdf`;
          link.click();
          URL.revokeObjectURL(url);
        });
      }

      if (verifyInvoiceBtn) {
        verifyInvoiceBtn.addEventListener("click", async () => {
          const trackingId = verifyTrackingId.value.trim();
          if (!trackingId) {
            alert("Tracking ID required.");
            return;
          }
          if (!invoiceFile.files || !invoiceFile.files[0]) {
            alert("Select an invoice PDF.");
            return;
          }
          const form = new FormData();
          form.append("trackingId", trackingId);
          form.append("invoice", invoiceFile.files[0]);

          const res = await fetch("/api/invoices/verify", {
            method: "POST",
            body: form
          });
          const payload = await res.json();
          if (!res.ok || !payload.success) {
            alert(payload.message || "Unable to verify invoice.");
            return;
          }
          setStatus(verifyResult, payload.authentic ? "Approved" : "Rejected");
          const status = payload.authentic ? "approved" : "rejected";
          window.location.href = `/documents/verified?trackingId=${encodeURIComponent(trackingId)}&status=${status}`;
        });
      }

      const attestInvoice = async (authentic) => {
        const trackingId = verifyTrackingId.value.trim();
        if (!trackingId) {
          alert("Tracking ID required.");
          return;
        }
        const onChain = await ensureGanacheChain();
        if (!onChain) {
          alert("Wrong network. Switch MetaMask to Ganache (Chain ID 1337).");
          return;
        }
        if (!window.ethereum) {
          alert("MetaMask not detected.");
          return;
        }
        const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
        const account = accounts && accounts[0] ? accounts[0] : "";
        if (!account) {
          alert("Connect MetaMask to continue.");
          return;
        }
        const res = await fetch("/api/invoices/tx/attest", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ trackingId, authentic, account })
        });
        const payload = await res.json();
        if (!res.ok || !payload.success) {
          alert(payload.message || "Unable to prepare attestation.");
          return;
        }
        await sendTx(payload.txData);
        setStatus(verifyResult, authentic ? "Approved" : "Rejected");
      };

      if (approveInvoiceBtn) {
        approveInvoiceBtn.addEventListener("click", () => attestInvoice(true));
      }

      if (rejectInvoiceBtn) {
        rejectInvoiceBtn.addEventListener("click", () => attestInvoice(false));
      }
    </script>
  </body>
</html>
