<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Wallet</title>
  <style>
    @import url("https://fonts.googleapis.com/css2?family=Fraunces:wght@600;700&family=Space+Grotesk:wght@400;500;600;700&display=swap");

    :root {
      --blue-900: #1e3a8a;
      --blue-700: #1d4ed8;
      --blue-600: #2563eb;
      --blue-500: #3b82f6;
      --blue-100: #dbeafe;
      --gray-900: #0f172a;
      --gray-700: #334155;
      --gray-600: #475569;
      --gray-500: #64748b;
      --gray-200: #e2e8f0;
      --gray-100: #f1f5f9;
      --green-600: #16a34a;
      --yellow-600: #ca8a04;
      --red-600: #dc2626;
      --card-shadow: 0 18px 40px rgba(15, 23, 42, 0.08);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
      color: var(--gray-900);
      background: radial-gradient(circle at top, #f5f7ff 0%, #f8fbff 48%, #f2f6ff 100%);
    }

    .wallet-hero {
      background: linear-gradient(120deg, #1e40af 0%, #2563eb 55%, #3b82f6 100%);
      color: #fff;
      padding: 38px 24px 44px;
      position: relative;
      overflow: hidden;
    }

    .wallet-hero::after {
      content: "";
      position: absolute;
      width: 420px;
      height: 420px;
      border-radius: 50%;
      background: radial-gradient(circle, rgba(255, 255, 255, 0.25), transparent 70%);
      top: -140px;
      right: -120px;
    }

    .wallet-hero h1 {
      margin: 0 0 6px;
      font-family: "Fraunces", Georgia, serif;
      font-size: clamp(1.7rem, 3vw, 2.3rem);
    }

    .wallet-hero p {
      margin: 0;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.85);
    }

    .wallet-connect {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 18px;
    }

    .wallet-connect .btn {
      min-width: 200px;
    }

    .wallet-connect-status {
      font-size: 13px;
      padding: 6px 12px;
      border-radius: 999px;
      font-weight: 600;
    }

    .wallet-network {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.85);
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .wallet-connect-note {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.75);
      width: 100%;
      margin-top: 4px;
    }

    .wallet-hero .hero-inner {
      max-width: 1200px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
      padding: 0 12px;
    }

    .page {
      max-width: 1200px;
      margin: 0 auto;
      padding: 26px 24px 70px;
    }

    .grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 24px;
    }

    .card {
      background: #fff;
      border-radius: 16px;
      padding: 18px;
      border: 1px solid var(--gray-200);
      box-shadow: var(--card-shadow);
    }

    .card h3 {
      margin: 0 0 14px;
      font-size: 14px;
      color: var(--gray-700);
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--blue-600);
      display: inline-block;
    }

    .balance-summary {
      background: linear-gradient(135deg, #1d4ed8 0%, #3b82f6 100%);
      color: #fff;
      padding: 18px;
      border-radius: 14px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
    }

    .balance-summary .total-label {
      font-size: 12px;
      opacity: 0.85;
    }

    .balance-summary .total-value {
      font-size: 28px;
      font-weight: 700;
      line-height: 1.1;
      margin-top: 6px;
    }

    .balance-summary .total-currency {
      font-size: 12px;
      opacity: 0.8;
      letter-spacing: 1px;
    }

    .balance-icon {
      width: 54px;
      height: 54px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.15);
      display: grid;
      place-items: center;
    }

    .balance-icon svg {
      width: 26px;
      height: 26px;
      stroke: #ffffff;
    }

    .mini-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-top: 16px;
    }

    .mini-card {
      background: var(--gray-100);
      border-radius: 12px;
      padding: 14px;
    }

    .mini-card span {
      font-size: 12px;
      color: var(--gray-500);
    }

    .mini-card h4 {
      margin: 8px 0 4px;
      font-size: 16px;
    }

    .mini-card p {
      margin: 0;
      font-size: 12px;
      color: var(--gray-500);
    }

    .wallet-address {
      margin-top: 16px;
    }

    .wallet-address label {
      font-size: 12px;
      color: var(--gray-600);
      display: block;
      margin-bottom: 6px;
    }

    .address-bar {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #f8fafc;
      border: 1px solid var(--gray-200);
      border-radius: 10px;
      padding: 10px 12px;
      font-size: 12px;
      color: var(--gray-700);
      overflow: hidden;
    }

    .address-bar code {
      font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      flex: 1;
    }

    .copy-btn {
      border: 1px solid var(--gray-200);
      background: #fff;
      border-radius: 8px;
      padding: 6px 10px;
      font-size: 12px;
      cursor: pointer;
    }

    .wallet-actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
      margin-top: 16px;
    }

    .btn {
      border: none;
      border-radius: 10px;
      padding: 10px 12px;
      font-weight: 600;
      cursor: pointer;
      font-size: 13px;
    }

    .btn-primary {
      background: #0f172a;
      color: #fff;
    }

    .btn-outline {
      background: #fff;
      border: 1px solid var(--gray-200);
      color: var(--gray-700);
    }

    .token-info dl {
      margin: 0;
      display: grid;
      grid-template-columns: 1fr;
      gap: 12px;
      font-size: 13px;
      color: var(--gray-600);
    }

    .token-info dt {
      font-weight: 600;
      color: var(--gray-900);
      margin-bottom: 4px;
    }

    .token-info dd {
      margin: 0;
      word-break: break-all;
    }

    .token-tag {
      margin-top: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 1px solid #bfdbfe;
      color: #1d4ed8;
      background: #eff6ff;
      border-radius: 10px;
      padding: 6px 10px;
      font-size: 12px;
      font-weight: 600;
    }

    .history {
      margin-top: 24px;
    }
    .history-empty {
      margin: 0;
      font-size: 14px;
      color: var(--gray-600);
      padding: 24px 0;
      border-top: 1px solid #eff2ff;
    }

    .tabs {
      display: inline-flex;
      background: var(--gray-100);
      border-radius: 999px;
      padding: 4px;
      gap: 4px;
      margin-bottom: 16px;
    }

    .tab {
      padding: 6px 10px;
      border-radius: 999px;
      font-size: 12px;
      color: var(--gray-600);
      font-weight: 600;
      background: transparent;
      border: none;
    }

    .tab.active {
      background: #fff;
      color: var(--gray-900);
      box-shadow: 0 8px 16px rgba(15, 23, 42, 0.08);
    }

    .history-item {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 14px;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid var(--gray-200);
      background: #fff;
      margin-bottom: 12px;
      align-items: center;
    }

    .history-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: grid;
      place-items: center;
      background: #eff6ff;
      color: var(--blue-600);
      font-weight: 700;
      font-size: 14px;
    }

    .history-item h4 {
      margin: 0;
      font-size: 14px;
    }

    .history-item p {
      margin: 2px 0 0;
      font-size: 12px;
      color: var(--gray-500);
    }

    .history-amount {
      text-align: right;
      font-weight: 700;
      font-size: 13px;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      padding: 4px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      margin-top: 6px;
    }

    .status-completed {
      background: #ecfdf3;
      color: var(--green-600);
    }

    .status-pending {
      background: #fef9c3;
      color: var(--yellow-600);
    }

    .status-alert {
      background: #fee2e2;
      color: #b91c1c;
    }

    .amount-negative {
      color: var(--red-600);
    }

    @media (max-width: 960px) {
      .grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 720px) {
      .mini-cards {
        grid-template-columns: 1fr;
      }

      .wallet-actions {
        grid-template-columns: 1fr;
      }

      .history-item {
        grid-template-columns: 1fr;
        text-align: left;
      }

      .history-amount {
        text-align: left;
      }
    }
  </style>
</head>
<body>
  <%- include('partials/navbar', { acct }) %>

  <section class="wallet-hero">
    <div class="hero-inner">
      <h1>My Wallet</h1>
      <p>Manage your tokens and view transaction history</p>
      <div class="wallet-connect">
        <button id="connect-wallet-btn" class="btn btn-primary" type="button">Connect MetaMask</button>
        <div id="wallet-status" class="wallet-connect-status status-pill status-pending">Not connected</div>
        <div id="chain-name" class="wallet-network">Network • Unknown</div>
        <p class="wallet-connect-note">Connect your MetaMask wallet to load live balances and transaction data.</p>
      </div>
    </div>
  </section>

  <main class="page">
    <section class="grid">
      <div class="card">
        <h3><span class="badge-dot"></span> Wallet Balance</h3>

        <div class="balance-summary">
          <div>
            <div class="total-label">Total Balance</div>
            <div class="total-value" id="total-balance"><%= wallet.totalBalance %></div>
            <div class="total-currency" id="total-currency"><%= wallet.symbol %></div>
          </div>
          <div class="balance-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke-width="2">
              <circle cx="12" cy="12" r="8"></circle>
              <path d="M8 12h8"></path>
              <path d="M12 8v8"></path>
            </svg>
          </div>
        </div>

        <div class="mini-cards">
         <div class="mini-card">
            <span><%= wallet.symbol %> Balance</span>
            <h4 id="eth-balance-value"><%= wallet.ethBalance %></h4>
            <p id="eth-balance-usd"><%= wallet.ethUsd %></p>
          </div>
          <div class="mini-card">
            <span><%= wallet.symbol %> Balance</span>
            <h4><%= wallet.tokenBalance %></h4>
            <p><%= wallet.tokenUsd %></p>
          </div>
        </div>

        <div class="wallet-address">
          <label>Wallet Address</label>
          <div class="address-bar">
            <code id="wallet-address"><%= wallet.address %></code>
            <button class="copy-btn" type="button">Copy</button>
          </div>
        </div>

        <div class="wallet-actions">
          <button class="btn btn-primary" type="button">Send Tokens</button>
          <button class="btn btn-outline" type="button">Receive</button>
        </div>
      </div>

      <aside class="card token-info">
        <h3><span class="badge-dot"></span> Token Info</h3>
        <dl>
          <div>
            <dt>Token Name</dt>
            <dd><%= wallet.token.name %></dd>
          </div>
          <div>
            <dt>Symbol</dt>
            <dd><%= wallet.token.symbol %></dd>
          </div>
          <div>
            <dt>Contract Address</dt>
            <dd><%= wallet.token.contractAddress %></dd>
          </div>
          <div>
            <dt>Total Supply</dt>
            <dd><%= wallet.token.totalSupply %></dd>
          </div>
        </dl>
        <div class="token-tag"><%= wallet.token.standard %></div>
      </aside>
    </section>

    <section class="card history">
      <h3><span class="badge-dot"></span> Transaction History</h3>
      <div class="tabs" role="tablist">
        <button class="tab active" type="button">All</button>
        <button class="tab" type="button">Payments</button>
        <button class="tab" type="button">Deliveries</button>
      </div>

      <% if (wallet.transactions && wallet.transactions.length) { %>
        <% wallet.transactions.forEach((tx) => { %>
          <div class="history-item">
            <div class="history-icon"><%= tx.type[0] %></div>
            <div>
              <h4><%= tx.type %></h4>
              <p><%= tx.date %></p>
              <p>Tx: <%= tx.tx %></p>
            </div>
            <div class="history-amount">
              <div class="<%= tx.amount.startsWith('-') ? 'amount-negative' : '' %>"><%= tx.amount %></div>
              <div class="status-pill <%= tx.status === 'completed' ? 'status-completed' : 'status-pending' %>"><%= tx.status %></div>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <p class="history-empty">You're all caught up — no transactions yet. Connect your MetaMask account to start tracking activity.</p>
      <% } %>
    </section>
  </main>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const connectButton = document.getElementById("connect-wallet-btn");
      const statusEl = document.getElementById("wallet-status");
      const addressEl = document.getElementById("wallet-address");
      const totalBalanceEl = document.getElementById("total-balance");
      const ethBalanceEl = document.getElementById("eth-balance-value");
      const ethUsdEl = document.getElementById("eth-balance-usd");
      const networkEl = document.getElementById("chain-name");
      const copyBtn = document.querySelector(".copy-btn");
      const usdPerEth = 1850;

      const chainNames = {
        "0x1": "Ethereum Mainnet",
        "0x5": "Goerli Testnet",
        "0x3": "Ropsten Legacy",
        "0x4": "Rinkeby Legacy",
        "0x89": "Polygon Mainnet",
        "0x13881": "Mumbai Testnet"
      };

      const activateStatus = (text, tone = "pending") => {
        if (!statusEl) return;
        statusEl.textContent = text;
        statusEl.classList.remove("status-completed", "status-pending", "status-alert");
        const toneClass =
          tone === "success" ? "status-completed" : tone === "error" ? "status-alert" : "status-pending";
        statusEl.classList.add(toneClass);
      };

      const formatUsd = (value) =>
        value.toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });

      const updateNetworkName = async () => {
        if (!window.ethereum || !networkEl) return;
        try {
          const chainId = await window.ethereum.request({ method: "eth_chainId" });
          const friendly = chainNames[chainId] || `Chain ${parseInt(chainId, 16)}`;
          networkEl.textContent = `Network • ${friendly}`;
        } catch {
          // ignore
        }
      };

      const updateAccountData = async (account) => {
        if (!window.ethereum || !account) return;
        try {
          const balanceHex = await window.ethereum.request({
            method: "eth_getBalance",
            params: [account, "latest"]
          });
          const balanceValue = balanceHex ? Number(BigInt(balanceHex)) / 1e18 : 0;
          const display = balanceValue.toFixed(4);
          if (totalBalanceEl) totalBalanceEl.textContent = display;
          if (ethBalanceEl) ethBalanceEl.textContent = display;
          if (ethUsdEl) ethUsdEl.textContent = `$${formatUsd(balance * usdPerEth)}`;
        } catch (error) {
          console.error("Balance read failed", error);
        }
      };

      const handleAccounts = async (accounts) => {
        if (!accounts || !accounts.length) {
          activateStatus("Wallet disconnected", "pending");
          if (connectButton) {
            connectButton.textContent = "Connect MetaMask";
            connectButton.disabled = false;
          }
          return;
        }

        const [account] = accounts;
        if (addressEl) {
          addressEl.textContent = account;
        }
        activateStatus("MetaMask connected", "success");
        if (connectButton) {
          connectButton.textContent = "Connected";
          connectButton.disabled = true;
        }
        await Promise.all([updateAccountData(account), updateNetworkName()]);
      };

      const connectWallet = async () => {
        if (!window.ethereum) {
          activateStatus("MetaMask not detected", "error");
          if (connectButton) connectButton.disabled = true;
          return;
        }

        try {
          const accounts = await window.ethereum.request({ method: "eth_requestAccounts" });
          await handleAccounts(accounts);
        } catch (error) {
          const rejected = error?.code === 4001;
          activateStatus(rejected ? "Connection rejected" : "Unable to connect", "error");
        }
      };

      if (copyBtn && addressEl) {
        copyBtn.addEventListener("click", async () => {
          const text = addressEl.textContent.trim();
          if (!text) return;
          try {
            await navigator.clipboard.writeText(text);
            const original = copyBtn.textContent;
            copyBtn.textContent = "Copied";
            setTimeout(() => (copyBtn.textContent = original), 1200);
          } catch {
            // fallback to manual selection
            const range = document.createRange();
            range.selectNodeContents(addressEl);
            const selection = window.getSelection();
            selection.removeAllRanges();
            selection.addRange(range);
            document.execCommand("copy");
            selection.removeAllRanges();
          }
        });
      }

      if (!window.ethereum) {
        activateStatus("MetaMask not installed", "error");
        if (connectButton) connectButton.disabled = true;
        return;
      }

      if (connectButton) {
        connectButton.addEventListener("click", connectWallet);
      }

      window.ethereum.on?.("accountsChanged", handleAccounts);
      window.ethereum.on?.("chainChanged", () => updateNetworkName());

      updateNetworkName();
    });
  </script>
</body>
</html>
