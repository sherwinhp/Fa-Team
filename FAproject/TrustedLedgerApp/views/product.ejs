<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= product.productInfo.name %> | Blockchain Marketplace</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --blue-600: #2563eb;
        --blue-700: #1d4ed8;
        --blue-50: #eff6ff;
        --blue-100: #dbeafe;
        --orange-600: #ea580c;
        --red-600: #dc2626;
        --yellow-400: #facc15;
        --green-600: #16a34a;
        --green-700: #15803d;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #d1d5db;
        --gray-500: #6b7280;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-900: #111827;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        color: var(--gray-900);
        background: #ffffff;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        font-size: 14px;
        color: var(--gray-600);
        margin-bottom: 24px;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--gray-700);
      }

      .breadcrumb {
        font-size: 13px;
        color: var(--gray-500);
      }

      .product-grid {
        display: grid;
        grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
        gap: 40px;
        align-items: start;
      }

      .gallery {
        display: flex;
        flex-direction: column;
      }

      .main-image {
        aspect-ratio: 1 / 1;
        width: 100%;
        max-width: 500px;
        background: var(--gray-50);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 18px 30px rgba(17, 24, 39, 0.08);
      }

      .main-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .thumbs {
        display: flex;
        gap: 12px;
        margin-top: 16px;
        flex-wrap: wrap;
      }

      .thumb-button {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        border: 2px solid var(--gray-200);
        overflow: hidden;
        padding: 0;
        background: #fff;
        cursor: pointer;
        transition: border-color 0.2s ease;
      }

      .thumb-button.active {
        border-color: var(--blue-600);
      }

      .thumb-button:hover {
        border-color: var(--blue-700);
      }

      .thumb-button img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .info h1 {
        font-size: 30px;
        font-weight: 700;
        margin: 0 0 12px;
      }

      .rating {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
      }

      .stars {
        display: inline-flex;
        gap: 4px;
      }

      .stars svg {
        width: 20px;
        height: 20px;
      }

      .rating-value {
        font-size: 18px;
        font-weight: 600;
      }

      .rating-count {
        color: var(--gray-500);
      }

      .seller-card {
        background: var(--blue-50);
        border: 1px solid var(--blue-100);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
      }

      .seller-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }

      .seller-name {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 8px;
      }

      .seller-label {
        font-size: 12px;
        color: var(--gray-600);
        margin-bottom: 6px;
      }

      .seller-stats {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: var(--gray-600);
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid var(--green-600);
        background: #e7f8ee;
        color: var(--green-700);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
      }

      .price-block {
        margin: 20px 0 24px;
      }

      .price-row {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 10px;
      }

      .price-value {
        font-size: 36px;
        font-weight: 700;
        color: var(--blue-600);
      }

      .price-currency {
        font-size: 20px;
        color: var(--gray-500);
      }

      .stock-row {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        color: var(--gray-600);
      }

      .stock-row .badge {
        border-color: var(--green-600);
      }

      .actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 24px;
      }

      .login-required {
        grid-column: 1 / -1;
        border: 1px dashed var(--gray-200);
        border-radius: 10px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: var(--gray-600);
        font-size: 14px;
        background: var(--gray-50);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        border: 1px solid var(--gray-200);
        background: #fff;
        color: var(--gray-900);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .btn.primary {
        background: var(--blue-600);
        color: #fff;
        border-color: var(--blue-600);
      }

      .btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.15);
      }

      .tabs {
        margin-top: 32px;
      }

      .tabs-list {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        border-bottom: 1px solid var(--gray-200);
      }

      .tab-btn {
        background: transparent;
        border: none;
        padding: 12px 16px;
        font-size: 15px;
        font-weight: 600;
        color: var(--gray-600);
        cursor: pointer;
        border-bottom: 2px solid transparent;
      }

      .tab-btn.active {
        color: var(--blue-700);
        border-bottom-color: var(--blue-600);
      }

      .tab-content {
        display: none;
        padding: 24px 0 10px;
      }

      .tab-content.active {
        display: block;
      }

      .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 16px;
      }

      .feature-list {
        display: grid;
        gap: 10px;
      }

      .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: var(--gray-700);
      }

      .spec-table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        overflow: hidden;
      }

      .spec-table td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--gray-200);
        font-size: 14px;
        color: var(--gray-600);
      }

      .spec-table tr:nth-child(even) {
        background: var(--gray-50);
      }

      .spec-table td:first-child {
        font-weight: 600;
        color: var(--gray-700);
        width: 35%;
        border-right: 1px solid var(--gray-200);
      }

      .blockchain-card {
        background: var(--blue-50);
        border: 1px solid var(--blue-100);
        border-radius: 12px;
        padding: 18px;
        margin-top: 24px;
        color: #1e3a8a;
      }

      .blockchain-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 8px;
        font-size: 13px;
      }

      .blockchain-row code {
        background: #fff;
        padding: 4px 8px;
        border-radius: 6px;
        font-family: "Courier New", Courier, monospace;
        font-size: 12px;
      }

      .reviews-grid {
        display: grid;
        grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
        gap: 24px;
        margin-bottom: 28px;
      }

      .rating-summary {
        text-align: center;
      }

      .rating-summary .score {
        font-size: 48px;
        font-weight: 700;
        color: var(--blue-600);
        margin-bottom: 6px;
      }

      .rating-bars {
        display: grid;
        gap: 10px;
      }

      .bar-row {
        display: grid;
        grid-template-columns: 60px 1fr 50px;
        gap: 10px;
        align-items: center;
        font-size: 13px;
        color: var(--gray-600);
      }

      .bar {
        height: 10px;
        background: var(--gray-200);
        border-radius: 999px;
        overflow: hidden;
      }

      .bar span {
        display: block;
        height: 100%;
        background: var(--yellow-400);
      }

      .review-card {
        border: 1px solid var(--gray-200);
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 16px;
      }

      .review-header {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 12px;
      }

      .reviewer {
        display: flex;
        gap: 12px;
        align-items: center;
      }

      .avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--blue-600);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 700;
      }

      .review-meta {
        font-size: 13px;
        color: var(--gray-500);
        margin-top: 4px;
      }

      .review-actions {
        display: flex;
        gap: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--gray-100);
        font-size: 13px;
        color: var(--gray-600);
      }

      .review-actions a {
        color: var(--blue-600);
      }

      .tx-hash {
        margin-top: 10px;
        padding: 8px;
        background: var(--gray-50);
        border-radius: 6px;
        font-size: 12px;
        color: var(--gray-600);
        font-family: "Courier New", Courier, monospace;
      }

      .shipping-box {
        border: 1px solid var(--gray-200);
        border-radius: 12px;
        padding: 18px;
      }

      .shipping-grid {
        display: grid;
        gap: 12px;
      }

      @media (max-width: 900px) {
        .product-grid {
          grid-template-columns: 1fr;
        }

        .reviews-grid {
          grid-template-columns: 1fr;
        }

        .top-row {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>
    <main class="page">
      <div class="top-row">
        <a class="back-link" href="/">
          <span aria-hidden="true">&larr;</span>
          Back to Products
        </a>
        <div class="breadcrumb">Home / Products / <%= product.productInfo.name %></div>
      </div>

      <% const images = product.images && product.images.length ? product.images : ['/images/default-product.jpeg']; %>
      <% const loginHref = '/login?next=' + encodeURIComponent(returnTo || '/'); %>

      <section class="product-grid">
        <div class="gallery">
          <div class="main-image">
            <img id="mainImage" src="<%= images[0] %>" alt="<%= product.productInfo.name %>" />
          </div>
          <div class="thumbs">
            <% images.forEach((img, index) => { %>
              <button
                class="thumb-button <%= index === 0 ? 'active' : '' %>"
                type="button"
                data-thumb
                data-src="<%= img %>"
                aria-label="View image <%= index + 1 %>"
              >
                <img src="<%= img %>" alt="Thumbnail <%= index + 1 %>" />
              </button>
            <% }) %>
          </div>
        </div>

        <div class="info">
          <h1><%= product.productInfo.name %></h1>

          <div class="rating">
            <div class="stars" aria-label="Rating">
              <% for (let i = 1; i <= 5; i += 1) { %>
                <svg viewBox="0 0 24 24" fill="<%= i <= Math.floor(product.rating) ? '#facc15' : '#d1d5db' %>" stroke="<%= i <= Math.floor(product.rating) ? '#facc15' : '#d1d5db' %>">
                  <path d="M12 3.5l2.7 5.47 6.03.88-4.36 4.25 1.03 6.2L12 17.77 6.6 20.3l1.03-6.2L3.27 9.85l6.03-.88L12 3.5z" />
                </svg>
              <% } %>
            </div>
            <span class="rating-value"><%= product.rating.toFixed(1) %></span>
            <span class="rating-count">(<%= product.reviewCount.toLocaleString() %> reviews)</span>
          </div>

          <div class="seller-card">
            <div class="seller-top">
              <div>
                <div class="seller-label">Seller</div>
                <div class="seller-name"><%= product.seller.name %></div>
                <div class="seller-stats">
                  <span><strong><%= product.seller.rating %>%</strong> Positive</span>
                  <span>&bull;</span>
                  <span><%= product.seller.sales.toLocaleString() %> sales</span>
                </div>
              </div>
              <% if (product.seller.verified) { %>
                <span class="badge">
                  <span aria-hidden="true">&#10003;</span>
                  Verified Seller
                </span>
              <% } %>
            </div>
          </div>

          <div class="price-block">
            <div class="price-row">
              <span class="price-value">$ <%= product.productInfo.price %></span>
              <span class="price-currency">ETHR</span>
            </div>
            <div class="stock-row">
              <span>Stock: <%= product.stock %> units available</span>
              <span class="badge">
                <span aria-hidden="true">&#10003;</span>
                <%= product.status %>
              </span>
            </div>
          </div>

          <div class="actions">
            <% if (isLoggedIn) { %>
              <button class="btn" type="button">Add to Cart</button>
              <button class="btn primary" type="button">Buy Now</button>
              <button class="btn" type="button">Pay with QR</button>
              <button class="btn" type="button">Track Order</button>
            <% } else { %>
              <div class="login-required">
                <span>Log in to purchase, pay, or track orders.</span>
                <a class="btn primary" href="<%= loginHref %>">Log In to Buy</a>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <section class="tabs">
        <div class="tabs-list" role="tablist">
          <button class="tab-btn active" data-tab="description" type="button" role="tab">Description</button>
          <button class="tab-btn" data-tab="reviews" type="button" role="tab">
            Reviews
            <span class="badge" style="margin-left: 8px; border-color: var(--blue-100); background: #f3f4ff; color: var(--blue-700);">2.5K</span>
          </button>
          <button class="tab-btn" data-tab="shipping" type="button" role="tab">Shipping &amp; Tracking</button>
          <button class="tab-btn" data-tab="specs" type="button" role="tab">Specifications</button>
        </div>

        <div class="tab-content active" data-tab-content="description" role="tabpanel">
          <div class="section-title">
            <span aria-hidden="true">Product Description</span>
          </div>
          <p style="color: var(--gray-700); line-height: 1.7; max-width: 760px;">
            <%= product.fullDescription %>
          </p>

          <div style="margin-top: 20px;">
            <h4 style="margin: 0 0 12px;">Key Features:</h4>
            <div class="feature-list">
              <% product.features.forEach((feature) => { %>
                <div class="feature-item">
                  <span aria-hidden="true" style="color: var(--green-600); font-weight: 700;">&#10003;</span>
                  <span><%= feature %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div style="margin-top: 28px;">
            <h4 style="margin-bottom: 12px;">Technical Specifications</h4>
            <table class="spec-table">
              <tbody>
                <% product.specifications.forEach((spec, index) => { %>
                  <tr>
                    <td><%= spec.label %></td>
                    <td><%= spec.value %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="blockchain-card">
            <strong>Blockchain Verified Authenticity</strong>
            <div class="blockchain-row">
              <span>Smart Contract:</span>
              <code><%= product.blockchain.smartContractId %></code>
            </div>
            <div class="blockchain-row">
              <span>Last Verified:</span>
              <span><%= product.blockchain.lastVerified %></span>
            </div>
          </div>
        </div>

        <div class="tab-content" data-tab-content="reviews" role="tabpanel">
          <div class="reviews-grid">
            <div class="rating-summary">
              <div class="score"><%= product.rating.toFixed(1) %></div>
              <div class="stars" style="justify-content: center; margin-bottom: 8px;">
                <% for (let i = 1; i <= 5; i += 1) { %>
                  <svg viewBox="0 0 24 24" fill="#facc15" stroke="#facc15">
                    <path d="M12 3.5l2.7 5.47 6.03.88-4.36 4.25 1.03 6.2L12 17.77 6.6 20.3l1.03-6.2L3.27 9.85l6.03-.88L12 3.5z" />
                  </svg>
                <% } %>
              </div>
              <p style="color: var(--gray-600);">Based on <%= product.reviewCount.toLocaleString() %> reviews</p>
            </div>
            <div class="rating-bars">
              <% [5,4,3,2,1].forEach((rating) => { %>
                <div class="bar-row">
                  <span><%= rating %> star</span>
                  <div class="bar">
                    <span style="width: <%= ratingDistribution[rating] %>%"></span>
                  </div>
                  <span style="text-align: right;"><%= ratingCounts[rating] %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div style="margin-bottom: 16px;">
            <button class="btn primary" type="button">Write a Review</button>
          </div>

          <% reviews.forEach((review) => { %>
            <div class="review-card">
              <div class="review-header">
                <div class="reviewer">
                  <div class="avatar"><%= review.reviewerName.charAt(0) %></div>
                  <div>
                    <div style="font-weight: 600;"><%= review.reviewerName %></div>
                    <div class="review-meta">
                      <span>
                        <% for (let i = 1; i <= 5; i += 1) { %>
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="<%= i <= review.rating ? '#facc15' : '#d1d5db' %>" stroke="<%= i <= review.rating ? '#facc15' : '#d1d5db' %>">
                            <path d="M12 3.5l2.7 5.47 6.03.88-4.36 4.25 1.03 6.2L12 17.77 6.6 20.3l1.03-6.2L3.27 9.85l6.03-.88L12 3.5z" />
                          </svg>
                        <% } %>
                      </span>
                      <span style="margin-left: 6px;"><%= review.date %></span>
                    </div>
                  </div>
                </div>
                <% if (review.verifiedPurchase) { %>
                  <span class="badge">
                    <span aria-hidden="true">&#10003;</span>
                    Verified Purchase
                  </span>
                <% } %>
              </div>

              <h4 style="margin: 0 0 8px; font-size: 16px;"><%= review.title %></h4>
              <p style="color: var(--gray-700); margin: 0 0 8px;">
                <%= review.comment %>
              </p>

              <div class="review-actions">
                <span>Helpful (<%= review.helpfulVotes %>)</span>
                <a href="https://etherscan.io/tx/<%= review.blockchainTxHash %>" target="_blank" rel="noopener noreferrer">
                  Verify on Blockchain
                </a>
              </div>

              <div class="tx-hash">
                Transaction: <%= review.blockchainTxHash.slice(0, 22) %>...
              </div>
            </div>
          <% }) %>
        </div>

        <div class="tab-content" data-tab-content="shipping" role="tabpanel">
          <div class="shipping-box">
            <h3 style="margin: 0 0 12px;">Shipping and Tracking</h3>
            <div class="shipping-grid">
              <div>Carrier: Blockchain Logistics</div>
              <div>Estimated Delivery: 3-5 business days</div>
              <div>Tracking: Blockchain verified updates</div>
              <div>
                <a href="/shipping/tracker" class="btn" style="margin-top: 12px; display: inline-flex;">Open Tracking Dashboard</a>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" data-tab-content="specs" role="tabpanel">
          <table class="spec-table">
            <tbody>
              <% product.specifications.forEach((spec) => { %>
                <tr>
                  <td><%= spec.label %></td>
                  <td><%= spec.value %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>

    <script>
      const thumbButtons = document.querySelectorAll("[data-thumb]");
      const mainImage = document.getElementById("mainImage");
      thumbButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const src = btn.getAttribute("data-src");
          if (!src || !mainImage) return;
          mainImage.src = src;
          thumbButtons.forEach((item) => item.classList.remove("active"));
          btn.classList.add("active");
        });
      });

      const tabButtons = document.querySelectorAll("[data-tab]");
      const tabContents = document.querySelectorAll("[data-tab-content]");
      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const tab = btn.getAttribute("data-tab");
          if (!tab) return;
          tabButtons.forEach((item) => item.classList.remove("active"));
          btn.classList.add("active");
          tabContents.forEach((panel) => {
            panel.classList.toggle("active", panel.getAttribute("data-tab-content") === tab);
          });
        });
      });
    </script>
  </body>
</html>
