<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= product.productInfo.name %> | Blockchain Marketplace</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --blue-600: #2563eb;
        --blue-700: #1d4ed8;
        --blue-50: #eff6ff;
        --blue-100: #dbeafe;
        --orange-600: #ea580c;
        --red-600: #dc2626;
        --yellow-400: #facc15;
        --green-600: #16a34a;
        --green-700: #15803d;
        --gray-50: #f9fafb;
        --gray-100: #f3f4f6;
        --gray-200: #e5e7eb;
        --gray-300: #d1d5db;
        --gray-500: #6b7280;
        --gray-600: #4b5563;
        --gray-700: #374151;
        --gray-900: #111827;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        color: var(--gray-900);
        background: #ffffff;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      .page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 20px 60px;
      }

      .top-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        font-size: 14px;
        color: var(--gray-600);
        margin-bottom: 24px;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: var(--gray-700);
      }

      .breadcrumb {
        font-size: 13px;
        color: var(--gray-500);
      }

      .product-grid {
        display: grid;
        grid-template-columns: minmax(0, 520px) minmax(0, 1fr);
        gap: 40px;
        align-items: start;
      }

      .gallery {
        display: flex;
        flex-direction: column;
      }

      .main-image {
        aspect-ratio: 1 / 1;
        width: 100%;
        max-width: 500px;
        background: var(--gray-50);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 18px 30px rgba(17, 24, 39, 0.08);
      }

      .main-image img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
      }

      .thumbs {
        display: flex;
        gap: 12px;
        margin-top: 16px;
        flex-wrap: wrap;
      }

      .thumb-button {
        width: 80px;
        height: 80px;
        border-radius: 8px;
        border: 2px solid var(--gray-200);
        overflow: hidden;
        padding: 0;
        background: #fff;
        cursor: pointer;
        transition: border-color 0.2s ease;
      }

      .thumb-button.active {
        border-color: var(--blue-600);
      }

      .thumb-button:hover {
        border-color: var(--blue-700);
      }

      .thumb-button img {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }

      .info h1 {
        font-size: 30px;
        font-weight: 700;
        margin: 0 0 12px;
      }

      .rating {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
      }

      .stars {
        display: inline-flex;
        gap: 4px;
      }

      .stars svg {
        width: 20px;
        height: 20px;
      }

      .rating-value {
        font-size: 18px;
        font-weight: 600;
      }

      .rating-count {
        color: var(--gray-500);
      }

      .seller-card {
        background: var(--blue-50);
        border: 1px solid var(--blue-100);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
      }

      .seller-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 16px;
      }

      .seller-name {
        font-size: 18px;
        font-weight: 600;
        margin: 0 0 8px;
      }

      .seller-label {
        font-size: 12px;
        color: var(--gray-600);
        margin-bottom: 6px;
      }

      .seller-stats {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 13px;
        color: var(--gray-600);
      }

      .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid var(--green-600);
        background: #e7f8ee;
        color: var(--green-700);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
      }

      .price-block {
        margin: 20px 0 24px;
      }

      .price-row {
        display: flex;
        align-items: baseline;
        gap: 10px;
        margin-bottom: 10px;
      }

      .price-value {
        font-size: 36px;
        font-weight: 700;
        color: var(--blue-600);
      }

      .price-currency {
        font-size: 20px;
        color: var(--gray-500);
      }

      .stock-row {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        color: var(--gray-600);
      }

      .stock-row .badge {
        border-color: var(--green-600);
      }

      .actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 24px;
      }

      .action-form {
        display: contents;
      }

      .login-required {
        grid-column: 1 / -1;
        border: 1px dashed var(--gray-200);
        border-radius: 10px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: var(--gray-600);
        font-size: 14px;
        background: var(--gray-50);
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        border: 1px solid var(--gray-200);
        background: #fff;
        color: var(--gray-900);
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
      }

      .btn.primary {
        background: var(--blue-600);
        color: #fff;
        border-color: var(--blue-600);
      }

      .btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 8px 18px rgba(37, 99, 235, 0.15);
      }

      .tabs {
        margin-top: 32px;
      }

      .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 16px;
      }

      .feature-list {
        display: grid;
        gap: 10px;
      }

      .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        color: var(--gray-700);
      }

      .blockchain-card {
        background: var(--blue-50);
        border: 1px solid var(--blue-100);
        border-radius: 12px;
        padding: 18px;
        margin-top: 24px;
        color: #1e3a8a;
      }

      .blockchain-row {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 8px;
        font-size: 13px;
      }

      .blockchain-row code {
        background: #fff;
        padding: 4px 8px;
        border-radius: 6px;
        font-family: "Courier New", Courier, monospace;
        font-size: 12px;
      }

      .reviews-grid {
        display: grid;
        grid-template-columns: minmax(0, 240px) minmax(0, 1fr);
        gap: 24px;
        margin-bottom: 28px;
      }

      .rating-summary {
        text-align: center;
      }

      .rating-summary .score {
        font-size: 48px;
        font-weight: 700;
        color: var(--blue-600);
        margin-bottom: 6px;
      }

      .rating-bars {
        display: grid;
        gap: 10px;
      }

      .bar-row {
        display: grid;
        grid-template-columns: 60px 1fr 50px;
        gap: 10px;
        align-items: center;
        font-size: 13px;
        color: var(--gray-600);
      }

      .bar {
        height: 10px;
        background: var(--gray-200);
        border-radius: 999px;
        overflow: hidden;
      }

      .bar span {
        display: block;
        height: 100%;
        background: var(--yellow-400);
      }

      .review-card {
        border: 1px solid var(--gray-200);
        border-radius: 12px;
        padding: 18px;
        margin-bottom: 16px;
      }

      .review-header {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 12px;
      }

      .reviewer {
        display: flex;
        gap: 12px;
        align-items: center;
      }

      .avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: var(--blue-600);
        color: #fff;
        display: grid;
        place-items: center;
        font-weight: 700;
      }

      .review-meta {
        font-size: 13px;
        color: var(--gray-500);
        margin-top: 4px;
      }

      .review-actions {
        display: flex;
        gap: 16px;
        padding-top: 12px;
        border-top: 1px solid var(--gray-100);
        font-size: 13px;
        color: var(--gray-600);
      }

      .review-actions a {
        color: var(--blue-600);
      }

      .tx-hash {
        margin-top: 10px;
        padding: 8px;
        background: var(--gray-50);
        border-radius: 6px;
        font-size: 12px;
        color: var(--gray-600);
        font-family: "Courier New", Courier, monospace;
      }

      .shipping-box {
        border: 1px solid var(--gray-200);
        border-radius: 12px;
        padding: 18px;
      }

      .shipping-grid {
        display: grid;
        gap: 12px;
      }

      @media (max-width: 900px) {
        .product-grid {
          grid-template-columns: 1fr;
        }

        .reviews-grid {
          grid-template-columns: 1fr;
        }

        .top-row {
          flex-direction: column;
          align-items: flex-start;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>
    <main class="page">
      <div class="top-row">
        <a class="back-link" href="/">
          <span aria-hidden="true">&larr;</span>
          Back to Products
        </a>
        <div class="breadcrumb">Home / Products / <%= product.productInfo.name %></div>
      </div>

      <% const images = product.images && product.images.length ? product.images : ['/images/default-product.jpeg']; %>
      <% const loginHref = encodeURIComponent(returnTo || '/'); %>

      <section class="product-grid">
        <div class="gallery">
          <div class="main-image">
            <img id="mainImage" src="<%= images[0] %>" alt="<%= product.productInfo.name %>" />
          </div>
          <div class="thumbs">
            <% images.forEach((img, index) => { %>
              <button
                class="thumb-button <%= index === 0 ? 'active' : '' %>"
                type="button"
                data-thumb
                data-src="<%= img %>"
                aria-label="View image <%= index + 1 %>"
              >
                <img src="<%= img %>" alt="Thumbnail <%= index + 1 %>" />
              </button>
            <% }) %>
          </div>
        </div>

        <div class="info">
          <h1><%= product.productInfo.name %></h1>

          <div class="rating">
            <div class="stars" aria-label="Rating">
            <% for (let i = 1; i <= 5; i += 1) { %>
                <svg viewBox="0 0 24 24" fill="<%= i <= Math.floor(averageRating || 0) ? '#facc15' : '#d1d5db' %>" stroke="<%= i <= Math.floor(averageRating || 0) ? '#facc15' : '#d1d5db' %>">
                  <path d="M12 3.5l2.7 5.47 6.03.88-4.36 4.25 1.03 6.2L12 17.77 6.6 20.3l1.03-6.2L3.27 9.85l6.03-.88L12 3.5z" />
                </svg>
            <% } %>
          </div>
          <span class="rating-value"><%= Number(averageRating || 0).toFixed(1) %></span>
          <span class="rating-count">(<%= (reviewCount || 0).toLocaleString() %> reviews)</span>
          </div>

          <div class="seller-card">
            <div class="seller-top">
              <div>
                <div class="seller-label">Seller</div>
                <div class="seller-name"><%= product.seller.name %></div>
                <div class="seller-stats">
                  <span><strong><%= product.seller.rating %>%</strong> Positive</span>
                  <span>&bull;</span>
                  <span><%= product.seller.sales.toLocaleString() %> sales</span>
                </div>
              </div>
              <% if (product.seller.verified) { %>
                <span class="badge">
                  <span aria-hidden="true">&#10003;</span>
                  Verified Seller
                </span>
              <% } %>
            </div>
          </div>

          <div class="price-block">
            <div class="price-row">
              <span class="price-value">$ <%= product.productInfo.price %></span>
              <span class="price-currency">ETHR</span>
            </div>
            <div class="stock-row">
              <span>Stock: <%= product.stock %> units available</span>
              <span class="badge">
                <span aria-hidden="true">&#10003;</span>
                <%= product.status %>
              </span>
            </div>
          </div>

          <div class="actions">
            <% if (isLoggedIn && (userRole === 'admin' || userRole === 'super_admin')) { %>
              <div class="login-required">
                <span>Admins cannot purchase products. Manage listings from the Admin Dashboard.</span>
                <a class="btn" href="/admin/products/<%= product.id %>/edit">Edit Product</a>
              </div>
            <% } else if (isLoggedIn) { %>
              <button class="btn" id="addToCartButton" type="button" data-product-id="<%= product.id %>">Add to Cart</button>
              <button class="btn primary" id="buyNowButton" type="button">Buy Now</button>
            <% } else { %>
              <div class="login-required">
                <span>Connect MetaMask to purchase, pay, or track orders.</span>
                <button class="btn primary" id="connectToBuy" type="button">Connect MetaMask</button>
              </div>
            <% } %>
          </div>
        </div>
      </section>

      <section class="tabs">
        <div class="tab-content active" role="tabpanel">
          <div class="section-title">
            <span aria-hidden="true">Product Description</span>
          </div>
          <p style="color: var(--gray-700); line-height: 1.7; max-width: 760px;">
            <%= product.fullDescription %>
          </p>

          <div style="margin-top: 20px;">
            <h4 style="margin: 0 0 12px;">Key Features:</h4>
            <div class="feature-list">
              <% product.features.forEach((feature) => { %>
                <div class="feature-item">
                  <span aria-hidden="true" style="color: var(--green-600); font-weight: 700;">&#10003;</span>
                  <span><%= feature %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div style="margin-top: 28px;">
            <h4 style="margin-bottom: 12px;">Technical Specifications</h4>
            <table class="spec-table">
              <tbody>
                <% product.specifications.forEach((spec, index) => { %>
                  <tr>
                    <td><%= spec.label %></td>
                    <td><%= spec.value %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>

          <div class="blockchain-card">
            <strong>Blockchain Verified Authenticity</strong>
            <div class="blockchain-row">
              <span>Smart Contract:</span>
              <code><%= product.blockchain.smartContractId %></code>
            </div>
            <div class="blockchain-row">
              <span>Last Verified:</span>
              <span><%= product.blockchain.lastVerified %></span>
            </div>
          </div>
        </div>

        <div class="tab-content active" role="tabpanel">
          <div class="reviews-grid">
            <div class="rating-summary">
              <div class="score"><%= Number(averageRating || 0).toFixed(1) %></div>
              <div class="stars" style="justify-content: center; margin-bottom: 8px;">
                <% for (let i = 1; i <= 5; i += 1) { %>
                  <svg viewBox="0 0 24 24" fill="#facc15" stroke="#facc15">
                    <path d="M12 3.5l2.7 5.47 6.03.88-4.36 4.25 1.03 6.2L12 17.77 6.6 20.3l1.03-6.2L3.27 9.85l6.03-.88L12 3.5z" />
                  </svg>
                <% } %>
              </div>
              <p style="color: var(--gray-600);">Based on <%= (reviewCount || 0).toLocaleString() %> reviews</p>
            </div>
            <div class="rating-bars">
              <% [5,4,3,2,1].forEach((rating) => { %>
                <div class="bar-row">
                  <span><%= rating %> star</span>
                  <div class="bar">
                    <span style="width: <%= ratingDistribution[rating] %>%"></span>
                  </div>
                  <span style="text-align: right;"><%= ratingCounts[rating] %></span>
                </div>
              <% }) %>
            </div>
          </div>

          <div style="margin-bottom: 16px; color: var(--gray-500); font-size: 13px;">
            Reviews can only be submitted after delivery is completed. Use the Orders page to leave a review.
          </div>

          <% if (!reviews || !reviews.length) { %>
            <div class="review-card">
              <div class="review-header">
                <div class="reviewer">
                  <div class="avatar">★</div>
                  <div>
                    <div style="font-weight: 600;">No reviews yet</div>
                    <div class="review-meta">
                      <span>Be the first to review this product.</span>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% } %>
          <% (reviews || []).forEach((review) => { %>
            <div class="review-card">
              <div class="review-header">
                <div class="reviewer">
                  <div class="avatar"><%= review.reviewerName.charAt(0) %></div>
                  <div>
                    <div style="font-weight: 600;"><%= review.reviewerName %></div>
                    <div class="review-meta">
                      <span>
                        <% for (let i = 1; i <= 5; i += 1) { %>
                          <svg viewBox="0 0 24 24" width="14" height="14" fill="<%= i <= review.rating ? '#facc15' : '#d1d5db' %>" stroke="<%= i <= review.rating ? '#facc15' : '#d1d5db' %>">
                            <path d="M12 3.5l2.7 5.47 6.03.88-4.36 4.25 1.03 6.2L12 17.77 6.6 20.3l1.03-6.2L3.27 9.85l6.03-.88L12 3.5z" />
                          </svg>
                        <% } %>
                      </span>
                      <span style="margin-left: 6px;"><%= review.date %></span>
                    </div>
                  </div>
                </div>
                <% if (review.verifiedPurchase) { %>
                  <span class="badge">
                    <span aria-hidden="true">&#10003;</span>
                    Verified Purchase
                  </span>
                <% } %>
              </div>

              <h4 style="margin: 0 0 8px; font-size: 16px;"><%= review.title %></h4>
              <p style="color: var(--gray-700); margin: 0 0 8px;">
                <%= review.comment || "No comment provided." %>
              </p>

              <% if (review.photoHash) { %>
                <div style="margin-bottom: 8px; font-size: 12px; color: var(--gray-500);">
                  Photo: <%= review.photoHash %>
                </div>
              <% } %>

              <div class="review-actions">
                <span>Helpful (<%= review.helpfulVotes %>)</span>
                <a href="https://etherscan.io/tx/<%= review.blockchainTxHash %>" target="_blank" rel="noopener noreferrer">
                  Verify on Blockchain
                </a>
              </div>

              <div class="tx-hash">
                Transaction: <%= review.blockchainTxHash.slice(0, 22) %>...
              </div>

              <% if (review.adminReply) { %>
                <div class="review-card" style="margin-top:12px;background:#f8fafc;">
                  <div style="font-weight:600;">Admin Reply</div>
                  <div style="color: var(--gray-700); margin-top: 6px;"><%= review.adminReply %></div>
                </div>
              <% } else if (userRole === 'admin' || userRole === 'super_admin') { %>
                <div style="margin-top: 12px;">
                  <label style="font-size: 12px; color: var(--gray-500);">Admin Reply</label>
                  <textarea class="admin-reply-input" data-review-id="<%= review.reviewId %>" rows="2" style="width:100%;border-radius:10px;border:1px solid var(--gray-200);padding:8px;margin-top:6px;"></textarea>
                  <button class="btn" type="button" data-reply-submit="<%= review.reviewId %>" style="margin-top:8px;">Send Reply</button>
                </div>
              <% } %>
            </div>
          <% }) %>
        </div>
      </section>
    </main>

    <script>
      const thumbButtons = document.querySelectorAll("[data-thumb]");
      const mainImage = document.getElementById("mainImage");
      thumbButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const src = btn.getAttribute("data-src");
          if (!src || !mainImage) return;
          mainImage.src = src;
          thumbButtons.forEach((item) => item.classList.remove("active"));
          btn.classList.add("active");
        });
      });

      const addToCartButton = document.getElementById("addToCartButton");
      const buyNowButton = document.getElementById("buyNowButton");
      const connectToBuyButton = document.getElementById("connectToBuy");

      const sendTransaction = async (txData) => {
        if (!window.ethereum) {
          alert("MetaMask not detected.");
          return null;
        }
        try {
          return await window.ethereum.request({
            method: "eth_sendTransaction",
            params: [txData]
          });
        } catch (err) {
          alert("Transaction canceled or failed.");
          return null;
        }
      };

      const ensureBackendWeb3 = async (account) => {
        if (!account) {
          return null;
        }
        let contractAddress = "";
        if (window.ethereum) {
          try {
            const [chainId, contractResponse] = await Promise.all([
              window.ethereum.request({ method: "eth_chainId" }),
              fetch("/build/ShippingTrackerContract.json")
            ]);
            if (contractResponse.ok) {
              const contractInfo = await contractResponse.json();
              const chainDecimal = Number.parseInt(chainId, 16);
              const networks = contractInfo && contractInfo.networks ? contractInfo.networks : {};
              const networkInfo = networks[chainDecimal] || networks[String(chainDecimal)];
              contractAddress = networkInfo && networkInfo.address ? networkInfo.address : "";
            }
          } catch (err) {
            contractAddress = "";
          }
        }

        try {
          const response = await fetch("/web3Connect", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              contractAddress: contractAddress || "",
              acct: account,
              providerUrl: "<%= ganacheProviderUrl || '' %>" || undefined
            })
          });
          const payload = await response.json().catch(() => ({}));
          if (!response.ok) {
            return null;
          }
          return payload;
        } catch (err) {
          return null;
        }
      };

      if (addToCartButton) {
        addToCartButton.addEventListener("click", async () => {
          const productId = addToCartButton.dataset.productId;
          try {
            const response = await fetch("/api/cart/add", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ productId, quantity: 1 })
            });
            const payload = await response.json();
            if (!response.ok || !payload.success) {
              alert(payload.message || "Unable to add item to cart.");
              return;
            }
            window.location.href = "/cart";
          } catch (error) {
            alert(error.message || "Unable to add item to cart.");
          }
        });
      }

      if (buyNowButton) {
        buyNowButton.addEventListener("click", async () => {
          if (buyNowButton.dataset.processing === "true") {
            return;
          }
          buyNowButton.dataset.processing = "true";
          buyNowButton.disabled = true;
          const originalLabel = buyNowButton.textContent;
          buyNowButton.textContent = "Processing...";

          let account = "";
          if (window.appWallet && !window.appWallet.isConnected()) {
            const result = await window.appWallet.connect();
            account = result && result.account ? result.account : "";
          } else if (window.appWallet) {
            account = window.appWallet.getAccount();
          }
          if (!account) {
            buyNowButton.dataset.processing = "false";
            buyNowButton.disabled = false;
            buyNowButton.textContent = originalLabel;
            return;
          }

          const backendReady = await ensureBackendWeb3(account);
          if (!backendReady) {
            alert("Web3 not connected. Make sure MetaMask is on Ganache and try again.");
            buyNowButton.dataset.processing = "false";
            buyNowButton.disabled = false;
            buyNowButton.textContent = originalLabel;
            return;
          }

          const trackingId = `TRK-${Date.now()}`;
          const payload = {
            trackingId: trackingId,
            recipientName: "<%= userEmail || 'Marketplace Customer' %>",
            recipientAddress: "Address on file",
            itemDescription: "<%= product.productInfo.name %>",
            shipmentValue: "<%= product.productInfo.price %>",
            productIds: ["<%= product.id %>"],
            quantities: [1],
            productNames: ["<%= product.productInfo.name %>"],
            productImages: ["<%= (product.images && product.images.length) ? product.images[0] : '/images/default-product.jpeg' %>"],
            productPrices: ["<%= product.productInfo.price %>"],
            account
          };

          const res = await fetch("/createShipment", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload)
          });
          const data = await res.json();
          if (!data || !data.txData) {
            alert(data && data.message ? data.message : "Unable to create shipment.");
            buyNowButton.dataset.processing = "false";
            buyNowButton.disabled = false;
            buyNowButton.textContent = originalLabel;
            return;
          }

          const txHash = await sendTransaction(data.txData);
          if (!txHash) {
            buyNowButton.dataset.processing = "false";
            buyNowButton.disabled = false;
            buyNowButton.textContent = originalLabel;
            return;
          }

          try {
            const recordResponse = await fetch("/api/orders/tx/payment", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                trackingId,
                paymentTxHash: txHash,
                account
              })
            });
            const recordPayload = await recordResponse.json();
            if (recordResponse.ok && recordPayload.success) {
              await sendTransaction(recordPayload.txData);
            }
          } catch (err) {
            // ignore storage errors
          }

          window.location.href = `/shipping/tracker?trackingId=${encodeURIComponent(trackingId)}`;
        });
      }

      if (connectToBuyButton) {
        connectToBuyButton.addEventListener("click", async () => {
          if (!window.appWallet) {
            alert("MetaMask not detected.");
            return;
          }
          let account = "";
          if (window.appWallet.isConnected()) {
            account = window.appWallet.getAccount();
          } else {
            const result = await window.appWallet.connect();
            account = result && result.account ? result.account : "";
          }
          if (!account) {
            return;
          }
          const backend = await ensureBackendWeb3(account);
          if (!backend || !backend.active) {
            try {
              const response = await fetch("/api/users/tx/register-self", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ account })
              });
              const payload = await response.json();
              if (!response.ok || !payload.success) {
                alert(payload.message || "Unable to register wallet.");
                return;
              }
              const txHash = await sendTransaction(payload.txData);
              if (!txHash) {
                return;
              }
              await ensureBackendWeb3(account);
            } catch (err) {
              alert(err.message || "Unable to register wallet.");
              return;
            }
          }
          window.location.href = decodeURIComponent("<%= loginHref %>");
        });
      }

      document.addEventListener("click", async (event) => {
        const button = event.target.closest("[data-reply-submit]");
        if (!button) {
          return;
        }
        const reviewId = button.getAttribute("data-reply-submit");
        const input = document.querySelector(`.admin-reply-input[data-review-id="${reviewId}"]`);
        const reply = input ? input.value.trim() : "";
        if (!reply) {
          alert("Reply cannot be empty.");
          return;
        }
        let account = window.appWallet ? window.appWallet.getAccount() : "";
        if (!account && window.appWallet) {
          const result = await window.appWallet.connect();
          account = result && result.account ? result.account : "";
        }
        if (!account) {
          alert("Connect MetaMask to reply.");
          return;
        }
        const res = await fetch("/api/reviews/reply/tx", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            reviewId,
            reply,
            account
          })
        });
        const payload = await res.json();
        if (!res.ok || !payload.success) {
          alert(payload.message || "Unable to prepare reply.");
          return;
        }
        const txHash = await sendTransaction(payload.txData);
        if (txHash) {
          window.location.reload();
        }
      });
    </script>
  </body>
</html>
