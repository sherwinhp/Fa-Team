<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Leave a Review | Blockchain Track</title>
    <style>
      @import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");

      :root {
        --ink: #0f172a;
        --muted: #475569;
        --panel: #ffffff;
        --soft: #f5f7fb;
        --border: #e5e7eb;
        --brand: #2563eb;
        --brand-soft: #e0e7ff;
        --success: #10b981;
        --danger: #ef4444;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        font-family: "Space Grotesk", "Segoe UI", Tahoma, sans-serif;
        background: linear-gradient(180deg, #f8fafc, #eef2ff);
        color: var(--ink);
      }

      main.review-layout {
        max-width: 1200px;
        margin: 0 auto;
        padding: 24px 20px 80px;
      }

      .alert {
        border-radius: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
        background: #fee2e2;
        color: #b91c1c;
        border: 1px solid #fecdd3;
        font-size: 14px;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
        gap: 24px;
        background: #ffffff;
        border-radius: 24px;
        border: 1px solid rgba(37, 99, 235, 0.12);
        padding: 32px;
        box-shadow: 0 20px 35px rgba(15, 23, 42, 0.08);
      }

      .hero h1 {
        margin: 6px 0 12px;
        font-size: 32px;
        line-height: 1.2;
      }

      .hero p {
        margin: 0;
        color: var(--muted);
        line-height: 1.5;
      }

      .hero .eyebrow {
        text-transform: uppercase;
        letter-spacing: 0.2em;
        font-size: 12px;
        color: var(--brand);
      }

      .hero-stats {
        display: flex;
        flex-direction: column;
        gap: 14px;
      }

      .stat-card {
        background: var(--soft);
        border-radius: 16px;
        padding: 16px 20px;
        border: 1px solid rgba(37, 99, 235, 0.1);
      }

      .stat-card strong {
        display: block;
        font-size: 28px;
        margin-top: 6px;
      }

      .stat-card span {
        font-size: 12px;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.1em;
      }

      .review-grid {
        margin-top: 32px;
        display: grid;
        grid-template-columns: minmax(0, 0.9fr) minmax(0, 0.75fr);
        gap: 24px;
      }

      .card {
        background: var(--panel);
        border-radius: 22px;
        border: 1px solid var(--border);
        padding: 24px;
        box-shadow: 0 16px 30px rgba(15, 23, 42, 0.08);
      }

      .order-card h2,
      .form-card h2 {
        margin: 0 0 12px;
        font-size: 20px;
      }

      .order-summary {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 16px;
        font-size: 14px;
      }

      .order-summary strong {
        font-size: 16px;
      }

      .product-preview {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 12px;
        border-radius: 16px;
        background: #f8fafc;
      }

      .product-preview img {
        width: 70px;
        height: 70px;
        border-radius: 12px;
        object-fit: cover;
        border: 1px solid #e2e8f0;
      }

      .product-preview div span {
        color: var(--muted);
        font-size: 13px;
      }

      .order-items {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin-top: 16px;
      }

      .order-item {
        display: flex;
        justify-content: space-between;
        font-size: 14px;
        color: var(--muted);
      }

      .form-card .form-row {
        margin-bottom: 16px;
      }

      .form-row label {
        display: block;
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 6px;
      }

      .form-row input,
      .form-row select,
      .form-row textarea {
        width: 100%;
        border-radius: 12px;
        border: 1px solid #d1d5db;
        padding: 10px 14px;
        font-size: 14px;
        background: #f9fafb;
        font-family: inherit;
        resize: vertical;
      }

      .form-row textarea {
        min-height: 110px;
      }

      .slider-range {
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .slider-range input[type="range"] {
        flex: 1;
        accent-color: var(--brand);
      }

      .slider-range .badge {
        background: var(--brand-soft);
        border-radius: 999px;
        padding: 6px 10px;
        font-weight: 600;
        color: var(--brand);
        font-size: 14px;
      }

      .primary-btn {
        border: none;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: #fff;
        border-radius: 12px;
        padding: 12px 18px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        width: 100%;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .primary-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
      }

      .helper-text {
        margin-top: 12px;
        font-size: 13px;
        color: var(--muted);
      }

      .review-message {
        min-height: 24px;
        font-size: 13px;
        margin-top: 12px;
      }

      .review-message[data-type="error"] {
        color: var(--danger);
      }

      .review-message[data-type="success"] {
        color: var(--success);
      }

      .info-grid {
        margin-top: 32px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 24px;
      }

      .seller-card,
      .rating-card {
        background: var(--panel);
        border-radius: 18px;
        border: 1px solid var(--border);
        padding: 22px;
      }

      .seller-header {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 6px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .pill {
        background: #e0e7ff;
        color: var(--brand);
        font-size: 11px;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 999px;
      }

      .seller-description {
        color: var(--muted);
        font-size: 14px;
        line-height: 1.6;
      }

      .seller-stats {
        margin-top: 16px;
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
      }

      .stat-pill {
        background: #f8fafc;
        color: var(--muted);
        font-size: 12px;
        padding: 8px 12px;
        border-radius: 12px;
        border: 1px solid #e5e7eb;
      }

      .rating-row {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        margin-bottom: 10px;
      }

      .rating-row .bar {
        flex: 1;
        height: 8px;
        border-radius: 6px;
        background: #e2e8f0;
        overflow: hidden;
      }

      .rating-row .bar-fill {
        height: 100%;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
      }

      .rating-row .percent {
        min-width: 28px;
        text-align: right;
        color: var(--muted);
      }

      .reviews-section {
        margin-top: 32px;
      }

      .reviews-section h2 {
        margin-bottom: 14px;
        font-size: 20px;
      }

      .reviews-grid {
        display: grid;
        gap: 14px;
      }

      .review-card {
        padding: 18px;
        border-radius: 18px;
        background: #ffffff;
        border: 1px solid #e2e8f0;
      }

      .review-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
      }

      .review-stars {
        display: flex;
        gap: 4px;
      }

      .review-stars svg {
        width: 16px;
        height: 16px;
        fill: #facc15;
      }

      .review-meta {
        color: var(--muted);
        font-size: 12px;
      }

      .review-card p {
        margin: 8px 0;
        color: var(--ink);
        line-height: 1.5;
      }

      .review-card .meta-row {
        display: flex;
        gap: 14px;
        font-size: 12px;
        color: var(--muted);
      }

      @media (max-width: 1024px) {
        .review-grid {
          grid-template-columns: 1fr;
        }

        .hero {
          grid-template-columns: 1fr;
        }
      }

      @media (max-width: 640px) {
        .hero,
        .card {
          padding: 18px;
        }
      }
    </style>
  </head>
  <body>
    <%- include('partials/navbar', { acct }) %>

    <main class="review-layout">
      <% if (errorMessage) { %>
        <div class="alert"><%= errorMessage %></div>
      <% } %>

      <section class="hero">
        <div>
          <div class="eyebrow">Seller Reputation & Rating Contract</div>
          <h1>Leave a review that stays on-chain</h1>
          <p>
            Customer trust is strongly influenced by seller credibility. The reputation smart contract
            records verified purchase history, ratings, and dispute outcomes. Reputation scores update
            automatically and cannot be manipulated, creating a more reliable marketplace ranking system.
          </p>
        </div>
        <div class="hero-stats">
          <div class="stat-card">
            <span>Average rating</span>
            <strong><%= averageRating ? averageRating.toFixed(1) : "—" %>★</strong>
            <div style="font-size:12px;color:#475569;">Based on <%= reviewCount %> review<%= reviewCount === 1 ? "" : "s" %></div>
          </div>
          <div class="stat-card">
            <span>Order status</span>
            <strong><%= statusLabel %></strong>
            <div style="font-size:12px;color:#475569;"><%= delivered ? "Ready to review" : "Pending delivery" %></div>
          </div>
        </div>
      </section>

      <section class="review-grid">
        <article class="card order-card">
          <h2>Order <span style="font-weight:500;">#<%= trackingId %></span></h2>
          <div class="order-summary">
            <div><strong>Seller:</strong> <%= shipmentData && shipmentData.seller ? shipmentData.seller : "Unknown" %></div>
            <div><strong>Item:</strong> <%= shipmentData && shipmentData.itemDescription ? shipmentData.itemDescription : "On-chain product" %></div>
            <div><strong>Value:</strong> <%= shipmentData && shipmentData.shipmentValue ? shipmentData.shipmentValue : "—" %> ETH</div>
          </div>
          <% if (primaryProduct) { %>
            <div class="product-preview">
              <img src="<%= primaryProduct.imageUrl || "/images/default-product.jpeg" %>" alt="Product" />
              <div>
                <strong><%= primaryProduct.name || primaryProduct.productId %></strong>
                <span><%= Number(primaryProduct.priceEth || 0).toFixed(4) %> ETH • <%= primaryProduct.quantity || 1 %> item<%= primaryProduct.quantity > 1 ? "s" : "" %></span>
              </div>
            </div>
          <% } else { %>
            <div class="helper-text">Product details are not available yet.</div>
          <% } %>
          <div class="order-items">
            <% if (orderItems && orderItems.length) { %>
              <% orderItems.forEach((item) => { %>
                <div class="order-item">
                  <span><%= item.name || item.productId %></span>
                  <span><%= Number(item.priceEth || 0).toFixed(4) %> ETH</span>
                </div>
              <% }); %>
            <% } else { %>
              <div class="helper-text">Order item metadata unavailable.</div>
            <% } %>
          </div>
        </article>

        <article class="card form-card">
          <h2>Share your experience</h2>
          <div class="form-row">
            <label for="reviewProduct">Product</label>
            <% if (orderItems && orderItems.length) { %>
              <select id="reviewProduct" <%= delivered ? "" : "disabled" %>>
                <% orderItems.forEach((item) => { %>
                  <option value="<%= item.productId %>">
                    <%= item.name || item.productId %> (<%= item.quantity || 1 %> unit<%= item.quantity > 1 ? "s" : "" %>)
                  </option>
                <% }) %>
              </select>
            <% } else { %>
              <input type="text" disabled value="Product data unavailable" />
            <% } %>
          </div>
          <div class="form-row slider-range">
            <label for="deliveryRating">Rating</label>
            <input
              id="deliveryRating"
              type="range"
              min="1"
              max="5"
              value="5"
              <%= delivered ? "" : "disabled" %>
            />
            <div class="badge" id="ratingValue">5</div>
          </div>
          <div class="form-row">
            <label for="deliveryComment">Comment (hashed)</label>
            <textarea
              id="deliveryComment"
              placeholder="Paste the hash of your verified experience notes..."
              <%= delivered ? "" : "disabled" %>
            ></textarea>
          </div>
          <div class="form-row">
            <label for="deliveryPhoto">Evidence hash (optional)</label>
            <input
              id="deliveryPhoto"
              type="text"
              placeholder="0x..."
              <%= delivered ? "" : "disabled" %>
            />
          </div>
          <button id="submitReview" class="primary-btn" type="button" <%= delivered && orderItems && orderItems.length ? "" : "disabled" %>>
            Submit review with MetaMask
          </button>
          <p class="helper-text">
            <%= delivered ? "Your review will be recorded on-chain once all MetaMask transactions are confirmed." : "Review submissions unlock as soon as the order is marked Delivered on the blockchain." %>
          </p>
          <div id="reviewMessage" class="review-message" data-type=""></div>
        </article>
      </section>

      <section class="info-grid">
        <article class="seller-card">
          <div class="seller-header">
            <span>On-chain seller reputation</span>
            <span class="pill">Immutable</span>
          </div>
          <p class="seller-description">
            Reputation scores are a direct reflection of verified purchases, dispute outcomes, and ratings
            stored immutably in the reputation smart contract. That creates a trust signal buyers can rely on.
          </p>
          <div class="seller-stats">
            <span class="stat-pill">
              Score: <strong><%= sellerReputation && sellerReputation.percent ? `${sellerReputation.percent}%` : "—" %></strong>
            </span>
            <span class="stat-pill">
              Sales: <strong><%= sellerReputation && sellerReputation.totalSales ? sellerReputation.totalSales : "—" %></strong>
            </span>
            <span class="stat-pill">
              Ratings: <strong><%= sellerReputation && sellerReputation.totalRatings ? sellerReputation.totalRatings : "—" %></strong>
            </span>
            <span class="stat-pill">
              Verified: <strong><%= sellerReputation && sellerReputation.verified ? "Yes" : "No" %></strong>
            </span>
          </div>
        </article>

        <article class="rating-card">
          <h3>Rating distribution</h3>
          <% for (let i = 5; i >= 1; i -= 1) { %>
            <div class="rating-row">
              <span><%= i %>★</span>
              <div class="bar">
                <div class="bar-fill" style="width:<%= (reviewSummary.ratingDistribution && reviewSummary.ratingDistribution[i]) || 0 %>%;"></div>
              </div>
              <span class="percent"><%= (reviewSummary.ratingDistribution && reviewSummary.ratingDistribution[i]) || 0 %>%</span>
            </div>
          <% } %>
          <p class="helper-text">
            The reputation smart contract keeps this distribution honest by tying reviews to confirmed purchase IDs.
          </p>
        </article>
      </section>

      <section class="reviews-section">
        <h2>Recent on-chain feedback</h2>
        <% if (!reviewSummary.reviews || !reviewSummary.reviews.length) { %>
          <div class="helper-text">No on-chain reviews yet. Be the first to submit verified feedback.</div>
        <% } else { %>
          <div class="reviews-grid">
            <% reviewSummary.reviews.slice(0, 4).forEach((review) => { %>
              <div class="review-card">
                <div class="review-header">
                  <div>
                    <strong><%= review.reviewerName %></strong>
                    <div class="review-meta"><%= review.date %></div>
                  </div>
                  <div class="review-stars">
                    <% for (let i = 1; i <= 5; i += 1) { %>
                      <svg viewBox="0 0 24 24">
                        <polygon points="12,17 6.5,20.5 7.5,13.5 3,9.5 10.5,8.5 12,2 13.5,8.5 21,9.5 16.5,13.5 17.5,20.5" fill="<%= i <= review.rating ? '#facc15' : '#d1d5db' %>" />
                      </svg>
                    <% } %>
                  </div>
                </div>
                <p><%= review.comment || "Shared on-chain feedback." %></p>
                <div class="meta-row">
                  <span>Tx: <%= review.blockchainTxHash.slice(0, 14) %>...</span>
                  <% if (review.photoHash) { %>
                    <span>Photo: <%= review.photoHash %></span>
                  <% } %>
                </div>
                <% if (review.adminReply) { %>
                  <div class="review-meta" style="margin-top:8px;">Admin reply: <%= review.adminReply %></div>
                <% } %>
              </div>
            <% }); %>
          </div>
        <% } %>
      </section>
    </main>

    <script>
      const trackingId = "<%= trackingId %>";
      const sellerAddress = "<%= sellerAddress %>";
      const delivered = <%= delivered ? "true" : "false" %>;
      const allowedChains = ["0x539", "0x1691"];
      const reviewButton = document.getElementById("submitReview");
      const ratingInput = document.getElementById("deliveryRating");
      const ratingValue = document.getElementById("ratingValue");
      const commentInput = document.getElementById("deliveryComment");
      const photoInput = document.getElementById("deliveryPhoto");
      const reviewProduct = document.getElementById("reviewProduct");
      const reviewMessage = document.getElementById("reviewMessage");

      const setMessage = (text, type = "info") => {
        if (!reviewMessage) {
          return;
        }
        reviewMessage.textContent = text;
        reviewMessage.dataset.type = type;
      };

      ratingInput?.addEventListener("input", () => {
        if (ratingValue) {
          ratingValue.textContent = ratingInput.value;
        }
      });

      reviewButton?.addEventListener("click", async () => {
        if (!delivered) {
          setMessage("Review submissions unlock once the order is marked Delivered.", "error");
          return;
        }
        if (!window.ethereum) {
          setMessage("MetaMask is required to sign review transactions.", "error");
          return;
        }
        const productId = reviewProduct ? reviewProduct.value : "";
        if (!productId) {
          setMessage("Select the product you helped evaluate.", "error");
          return;
        }
        const ratingValue = Number(ratingInput?.value || 0);
        const commentHash = commentInput ? commentInput.value.trim() : "";
        const photoHash = photoInput ? photoInput.value.trim() : "";

        const payload = {
          rating: ratingValue,
          commentHash,
          photoHash
        };

        const onChain = await ensureGanacheChain();
        if (!onChain) {
          setMessage("Switch MetaMask to the Ganache network (Chain ID 1337).", "error");
          return;
        }

        setMessage("Preparing review transaction...", "info");
        const res = await fetch(`/confirmDeliveryByBuyer/${encodeURIComponent(trackingId)}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data && data.txData) {
          await sendTransaction(data.txData);
          const hasReviewData = ratingValue > 0 || commentHash || photoHash;
          if (hasReviewData && productId) {
            const reviewRes = await fetch("/api/reviews/tx", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                productId,
                trackingId,
                rating: ratingValue,
                commentHash,
                photoHash
              })
            });
            const reviewPayload = await reviewRes.json();
            if (reviewPayload && reviewPayload.txData) {
              await sendTransaction(reviewPayload.txData);
            }
            if (ratingValue > 0 && sellerAddress) {
              const repRes = await fetch("/api/reputation/tx", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  seller: sellerAddress,
                  trackingId,
                  rating: ratingValue
                })
              });
              const repPayload = await repRes.json();
              if (repPayload && repPayload.txData) {
                await sendTransaction(repPayload.txData);
              }
            }
          }
          setMessage("Review submitted. Confirm MetaMask prompts to finalize.", "success");
          setTimeout(() => window.location.reload(), 2200);
        } else {
          setMessage(data?.message || "Unable to prepare review transaction.", "error");
        }
      });

      async function sendTransaction(txData) {
        if (!window.ethereum) {
          alert("MetaMask not detected.");
          return;
        }
        try {
          await window.ethereum.request({
            method: "eth_sendTransaction",
            params: [txData]
          });
        } catch (err) {
          setMessage("Transaction canceled or failed.", "error");
        }
      }

      async function ensureGanacheChain() {
        if (!window.ethereum) {
          return false;
        }
        const chainId = await window.ethereum.request({ method: "eth_chainId" });
        return chainId && allowedChains.includes(String(chainId).toLowerCase());
      }
    </script>
  </body>
</html>
